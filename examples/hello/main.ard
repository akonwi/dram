use dram
use go:strconv
use go:sync/atomic
use go:time

fn main() {
  let app = &mut dram::App::new()
  let active_event_streams = &mut atomic::Int64{}
  app.set_max_body_bytes(8)
  app.use(fn(request: dram::Request, response: &mut dram::Response, next: dram::Next) {
    response.headers.set("X-Powered-By", "Dram")
    next.run(request, response)
  })
  app.get("/", fn(request, response) {
    response.headers.add("Set-Cookie", "first=1; HttpOnly; SameSite=Lax")
    response.headers.add("Set-Cookie", "second=2; HttpOnly; SameSite=Lax")
    response.text(200, "Hello from Dram")
  })

  app.get("/hello/:name", fn(request, response) {
    let name = request.param("name").or("world")
    response.text(200, "Hello {name}!")
  })

  app.get("/files/*path", fn(request, response) {
    response.text(200, request.param("path").or(""))
  })

  app.get("/json", fn(request, response) {
    response.json(200, ["message": "Hello from Dram"])
  })

  app.get("/events", fn(request, response) {
    response.sse(fn(stream) {
      active_event_streams.Add(Int64::from(1))
      defer active_event_streams.Add(Int64::from(-1))
      mut message = 1
      while not stream.cancelled() {
        let value = strconv::Itoa(message)
        if not stream.send(data: "message {value}", event: "message", id: value) {
          break
        }
        message =+ 1
        time::Sleep(1 * time::Second)
      }
    })
  })

  app.get("/events/active", fn(request, response) {
    response.text(200, strconv::FormatInt(active_event_streams.Load(), 10))
  })

  app.get("/events/panic", fn(request, response) {
    response.sse(fn(stream) {
      stream.send(data: "visible")
      time::Sleep(50 * time::Millisecond)
      panic("after SSE commitment")
    })
  })

  app.get("/search", fn(request, response) {
    response.text(200, request.query("q").or(""))
  })

  app.post("/echo", fn(request: dram::Request, response: &mut dram::Response) {
    response.bytes(200, request.body)
  })

  app.not_found(fn(request, response) {
    response.text(404, "Not Found: {request.path}")
  })
  app.method_not_allowed(fn(request, response) {
    response.text(405, "Method Not Allowed")
  })

  app.listen(port: 8080).expect("Failed to start server")
}
