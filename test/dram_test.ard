use ard/testing
use ard/unsafe as ard_unsafe

use dram/context as request_context
use dram/dram
use go:net/http
use go:net/http/httptest
use go:strings

struct ValueKey {
  id: Int,
}

struct JsonPayload {
  message: Str,
  count: Int,
}

fn str_value(request: dram::Request, key: ValueKey) Str? {
  match request_context::value(request.context(), key) {
    boxed => ard_unsafe::cast<Str>(boxed),
    _ => Maybe::new(),
  }
}

fn serve_test_request(handler: http::Handler, method: Str, target: Str, body: Str) mut httptest::ResponseRecorder {
  let recorder = httptest::NewRecorder()
  let raw_request = httptest::NewRequest(method, target, strings::NewReader(body))
  handler.ServeHTTP(recorder, raw_request)
  recorder
}

fn order_middleware(label: Str) dram::Middleware {
  fn(request: dram::Request, response: mut dram::Response, next: dram::Next) {
    let current = response.headers.get("X-Order").or("")
    response.header("X-Order", "{current}{label}")
    next.run(request, response)
  }
}

test fn exact_route_uses_captured_dependency_and_middleware() Void!Str {
  let greeting = "Hello"
  mut app = dram::App::new()
  app.use(
    fn(request: dram::Request, response: mut dram::Response, next: dram::Next) {
      response.header("X-Middleware", "before")
      next.run(request, response)
      response.header("X-After", "yes")
      response.body = "{Str::from(response.body)} outer".bytes()
    },
  )
  app.use(
    fn(request: dram::Request, response: mut dram::Response, next: dram::Next) {
      next.run(request, response)
      response.body = "{Str::from(response.body)} inner".bytes()
    },
  )
  app.get(
    "/hello",
    fn(request: dram::Request, response: mut dram::Response) {
      response.text(200, "{greeting}, Dram!")
    },
  )

  let response = app.handle(dram::Request::new("GET", "/hello"))
  try testing::assert(response.status == 200, "GET route did not return 200")
  try testing::assert(
    Str::from(response.body) == "Hello, Dram! inner outer",
    "middleware did not wrap the route: {Str::from(response.body)}",
  )
  try testing::assert(response.headers.get("X-Middleware").or("") == "before", "before header missing")
  try testing::assert(response.headers.get("X-After").or("") == "yes", "after header missing")
  testing::pass()
}

test fn middleware_runs_for_not_found_and_method_not_allowed() Void!Str {
  mut app = dram::App::new()
  app.use(
    fn(request: dram::Request, response: mut dram::Response, next: dram::Next) {
      response.header("X-Middleware", "yes")
      next.run(request, response)
    },
  )
  app.get(
    "/known",
    fn(request: dram::Request, response: mut dram::Response) {
      response.text(200, "known")
    },
  )

  let missing = app.handle(dram::Request::new("GET", "/missing"))
  try testing::assert(missing.status == 404, "missing path did not return 404")
  try testing::assert(missing.headers.get("X-Middleware").or("") == "yes", "middleware skipped 404")

  let wrong_method = app.handle(dram::Request::new("POST", "/known"))
  try testing::assert(wrong_method.status == 405, "wrong method did not return 405")
  try testing::assert(wrong_method.headers.get("Allow").or("") == "GET, HEAD", "Allow header changed")
  try testing::assert(wrong_method.headers.get("X-Middleware").or("") == "yes", "middleware skipped 405")
  testing::pass()
}

test fn custom_not_found_and_method_not_allowed_handlers_run_with_global_middleware() Void!Str {
  mut app = dram::App::new()
  app.use(
    fn(request: dram::Request, response: mut dram::Response, next: dram::Next) {
      response.header("X-Global", "yes")
      next.run(request, response)
    },
  )
  app.not_found(
    fn(request, response) {
      response.text(response.status, "missing:{request.path}")
    },
  )
  app.method_not_allowed(
    fn(request, response) {
      response.text(response.status, "method:{request.param("id").or("missing")}")
    },
  )

  mut api = app.group("/api")
  api.use(
    fn(request: dram::Request, response: mut dram::Response, next: dram::Next) {
      response.header("X-Group", "yes")
      next.run(request, response)
    },
  )
  api.get(
    "/users/:id",
    fn(request, response) {
      response.text(200, request.param("id").or(""))
    },
  )

  let missing = app.handle(dram::Request::new("GET", "/api/missing"))
  try testing::assert(missing.status == 404, "custom not-found status changed")
  try testing::assert(
    Str::from(missing.body) == "missing:/api/missing",
    "custom not-found handler did not run",
  )
  try testing::assert(
    missing.headers.get("X-Global").or("") == "yes",
    "global middleware skipped fallback",
  )
  try testing::assert(
    missing.headers.get("X-Group").is_none(),
    "group middleware wrapped not-found handler",
  )

  let wrong_method = app.handle(dram::Request::new("POST", "/api/users/42"))
  try testing::assert(wrong_method.status == 405, "custom method-not-allowed status changed")
  try testing::assert(
    Str::from(wrong_method.body) == "method:missing",
    "method fallback received route params",
  )
  try testing::assert(
    wrong_method.headers.get("Allow").or("") == "GET, HEAD",
    "method fallback lost Allow",
  )
  try testing::assert(
    wrong_method.headers.get("X-Global").or("") == "yes",
    "global middleware skipped 405",
  )
  try testing::assert(
    wrong_method.headers.get("X-Group").is_none(),
    "group middleware wrapped 405 handler",
  )

  let head_missing = app.handle(dram::Request::new("HEAD", "/missing"))
  try testing::assert(
    head_missing.status == 404 and head_missing.body.size() == 0,
    "HEAD fallback body was sent",
  )
  try testing::assert(
    head_missing.headers.get("Content-Length").or("0") != "0",
    "HEAD fallback length was lost",
  )
  testing::pass()
}

test fn path_params_are_available_to_middleware_and_handlers() Void!Str {
  mut app = dram::App::new()
  app.use(
    fn(request: dram::Request, response: mut dram::Response, next: dram::Next) {
      response.header("X-User-Id", request.param("id").or(""))
      next.run(request, response)
    },
  )
  app.get(
    "/users/:id",
    fn(request, response) {
      let id = request.param("id").or("")
      let missing = request.param("missing").or("")
      response.text(200, "{id}:{missing}")
    },
  )

  let response = app.handle(dram::Request::new("GET", "/users/42"))
  try testing::assert(response.status == 200, "parameter route did not match")
  try testing::assert(Str::from(response.body) == "42:", "path parameter lookup changed")
  try testing::assert(response.headers.get("X-User-Id").or("") == "42", "middleware missed path params")

  let head = app.handle(dram::Request::new("HEAD", "/users/42"))
  try testing::assert(head.status == 200 and head.body.size() == 0, "HEAD parameter fallback failed")
  try testing::assert(head.headers.get("X-User-Id").or("") == "42", "HEAD fallback lost path params")

  let empty = app.handle(dram::Request::new("GET", "/users/"))
  try testing::assert(empty.status == 404, "path parameter matched an empty segment")

  let wrong_method = app.handle(dram::Request::new("POST", "/users/42"))
  try testing::assert(wrong_method.status == 405, "parameter path did not produce 405")
  try testing::assert(
    wrong_method.headers.get("X-User-Id").or("missing") == "",
    "405 exposed path params",
  )
  testing::pass()
}

test fn catch_all_params_capture_the_remaining_path() Void!Str {
  mut app = dram::App::new()
  app.use(
    fn(request: dram::Request, response: mut dram::Response, next: dram::Next) {
      response.header("X-Catch-All", request.param("path").or("missing"))
      next.run(request, response)
    },
  )
  app.get(
    "/files/*path",
    fn(request, response) {
      response.text(200, request.param("path").or("missing"))
    },
  )
  app.post(
    "/files/*path",
    fn(request, response) {
      response.text(201, request.param("path").or("missing"))
    },
  )

  let nested = app.handle(dram::Request::new("GET", "/files/images/logo.png"))
  try testing::assert(Str::from(nested.body) == "/images/logo.png", "catch-all remainder changed")
  try testing::assert(
    nested.headers.get("X-Catch-All").or("") == "/images/logo.png",
    "middleware missed catch-all param",
  )
  let root = app.handle(dram::Request::new("GET", "/files/"))
  try testing::assert(Str::from(root.body) == "/", "empty catch-all remainder changed")
  let prefix = app.handle(dram::Request::new("GET", "/files"))
  try testing::assert(prefix.status == 404, "catch-all matched without its slash")
  let other_method = app.handle(dram::Request::new("POST", "/files/archive.zip"))
  try testing::assert(other_method.status == 201, "catch-all pattern conflicted across methods")
  try testing::assert(Str::from(other_method.body) == "/archive.zip", "POST catch-all capture changed")
  let escaped = app.handle(dram::Request::new("GET", "/files/images%2Flogo.png"))
  try testing::assert(Str::from(escaped.body) == "/images/logo.png", "decoded slash was not captured")
  let head = app.handle(dram::Request::new("HEAD", "/files/images/logo.png"))
  try testing::assert(head.status == 200 and head.body.size() == 0, "catch-all HEAD fallback failed")
  testing::pass()
}

test fn catch_all_routes_validate_and_reject_overlaps() Void!Str {
  mut static_first = dram::App::new()
  static_first.get("/files/static", fn(request, response) {})
  let static_overlap = unsafe {
    static_first.get("/files/*path", fn(request, response) {})
  }
  try testing::assert(static_overlap.is_err(), "catch-all overlapped a static route")

  mut catch_all_first = dram::App::new()
  catch_all_first.get("/files/*path", fn(request, response) {})
  let parameter_overlap = unsafe {
    catch_all_first.get("/files/:name", fn(request, response) {})
  }
  try testing::assert(parameter_overlap.is_err(), "parameter route overlapped a catch-all")
  let trailing_overlap = unsafe {
    catch_all_first.get("/files/", fn(request, response) {})
  }
  try testing::assert(trailing_overlap.is_err(), "trailing-slash route overlapped a catch-all")

  let non_final = unsafe {
    catch_all_first.get("/assets/*path/edit", fn(request, response) {})
  }
  try testing::assert(non_final.is_err(), "non-final catch-all was accepted")
  let unnamed = unsafe {
    catch_all_first.get("/assets/*", fn(request, response) {})
  }
  try testing::assert(unnamed.is_err(), "unnamed catch-all was accepted")
  let duplicate_name = unsafe {
    catch_all_first.get("/orgs/:id/files/*id", fn(request, response) {})
  }
  try testing::assert(duplicate_name.is_err(), "duplicate catch-all name was accepted")

  mut compatible = dram::App::new()
  compatible.get(
    "/files",
    fn(request, response) {
      response.text(200, "prefix")
    },
  )
  compatible.get(
    "/files/*path",
    fn(request, response) {
      response.text(200, request.param("path").or(""))
    },
  )
  let prefix = compatible.handle(dram::Request::new("GET", "/files"))
  try testing::assert(Str::from(prefix.body) == "prefix", "non-overlapping prefix route was rejected")
  testing::pass()
}

test fn query_accessors_lazily_decode_raw_queries() Void!Str {
  let query_request = dram::Request::new(
    "GET",
    "/search?q=hello+world&items=one&items=two%20words&empty=&flag&encoded=%2Fdocs%3Fa%3D1",
  )
  try testing::assert(query_request.path == "/search", "request path changed")
  try testing::assert(query_request.query("q").or("") == "hello world", "plus decoding changed")
  try testing::assert(query_request.query("empty").or("missing") == "", "empty query value was lost")
  try testing::assert(query_request.query("flag").or("missing") == "", "bare query key was lost")
  try testing::assert(query_request.query("encoded").or("") == "/docs?a=1", "percent decoding changed")
  try testing::assert(query_request.query("missing").is_none(), "missing query value was present")
  let items = query_request.query_list("items")
  try testing::assert(items.size() == 2, "repeated query values were not preserved")
  try testing::assert(items.at(0).or("") == "one", "first repeated query value changed")
  try testing::assert(items.at(1).or("") == "two words", "second repeated query value changed")

  let derived = query_request.with_context(request_context::background())
  try testing::assert(derived.query("q").or("") == "hello world", "derived request lost its raw query")

  mut app = dram::App::new()
  app.get(
    "/search",
    fn(request, response) {
      response.text(200, request.query("q").or("missing"))
    },
  )
  let response = app.handle(query_request)
  try testing::assert(response.status == 200, "query string affected route matching")
  try testing::assert(Str::from(response.body) == "hello world", "handler could not read query")

  let partially_malformed = dram::Request::new("GET", "/search?good=yes&bad=%zz&later=ok")
  try testing::assert(partially_malformed.query("good").or("") == "yes", "valid leading query was lost")
  try testing::assert(partially_malformed.query("bad").is_none(), "malformed query value was exposed")
  try testing::assert(partially_malformed.query("later").or("") == "ok", "valid trailing query was lost")

  let escaped_path = dram::Request::new("GET", "/files/hello%20world?q=yes")
  try testing::assert(escaped_path.path == "/files/hello world", "escaped path was not decoded")
  let escaped_slash = dram::Request::new("GET", "/files/a%2Fb?q=yes")
  try testing::assert(escaped_slash.path == "/files/a/b", "escaped path slash was not decoded")
  let malformed_path = unsafe {
    dram::Request::new("GET", "/files/%zz?q=yes")
  }
  try testing::assert(malformed_path.is_err(), "malformed path escape was accepted")
  testing::pass()
}

test fn static_routes_outrank_params_and_equivalent_patterns_conflict() Void!Str {
  mut app = dram::App::new()
  app.get(
    "/users/:id",
    fn(request, response) {
      response.text(200, "param:{request.param("id").or("")}")
    },
  )
  app.get(
    "/users/new",
    fn(request, response) {
      response.text(200, "static")
    },
  )
  app.post(
    "/users/:name",
    fn(request, response) {
      response.text(201, request.param("name").or(""))
    },
  )

  let static_response = app.handle(dram::Request::new("GET", "/users/new"))
  try testing::assert(
    Str::from(static_response.body) == "static",
    "parameter route outranked static route",
  )
  let parameter_response = app.handle(dram::Request::new("GET", "/users/ada"))
  try testing::assert(
    Str::from(parameter_response.body) == "param:ada",
    "parameter route did not capture",
  )
  let other_method = app.handle(dram::Request::new("POST", "/users/ada"))
  try testing::assert(
    Str::from(other_method.body) == "ada",
    "same pattern shape was rejected across methods",
  )

  let conflicting = unsafe {
    app.get("/users/:name", fn(request, response) {})
  }
  try testing::assert(conflicting.is_err(), "equivalent parameter pattern was accepted")
  let duplicate_name = unsafe {
    app.get("/teams/:id/users/:id", fn(request, response) {})
  }
  try testing::assert(duplicate_name.is_err(), "duplicate path parameter name was accepted")
  testing::pass()
}

test fn groups_compose_static_prefixes_and_snapshot_middleware() Void!Str {
  mut app = dram::App::new()
  app.use(order_middleware("global,"))

  mut api = app.group("/api")
  api.get(
    "/before",
    fn(request, response) {
      response.text(200, "before")
    },
  )
  api.use(order_middleware("parent,"))
  api.get(
    "/after",
    fn(request, response) {
      response.text(200, "after")
    },
  )

  mut admin = api.group("/admin")
  admin.use(order_middleware("child,"))
  admin.get(
    "/users/:id",
    fn(request, response) {
      response.text(200, request.param("id").or(""))
    },
  )

  api.use(order_middleware("late,"))
  api.get(
    "/late",
    fn(request, response) {
      response.text(200, "late")
    },
  )
  admin.get(
    "/reports",
    fn(request, response) {
      response.text(200, "reports")
    },
  )

  let before = app.handle(dram::Request::new("GET", "/api/before"))
  try testing::assert(
    before.headers.get("X-Order").or("") == "global,",
    "group middleware was retroactive",
  )
  let after = app.handle(dram::Request::new("GET", "/api/after"))
  try testing::assert(
    after.headers.get("X-Order").or("") == "global,parent,",
    "parent middleware order changed",
  )
  let nested = app.handle(dram::Request::new("GET", "/api/admin/users/42"))
  try testing::assert(Str::from(nested.body) == "42", "nested group path did not compose")
  try testing::assert(
    nested.headers.get("X-Order").or("") == "global,parent,child,",
    "nested middleware inheritance changed",
  )
  let late = app.handle(dram::Request::new("GET", "/api/late"))
  try testing::assert(
    late.headers.get("X-Order").or("") == "global,parent,late,",
    "late middleware was not applied",
  )
  let child_after_late = app.handle(dram::Request::new("GET", "/api/admin/reports"))
  try testing::assert(
    child_after_late.headers.get("X-Order").or("") == "global,parent,child,",
    "existing child inherited middleware added later to its parent",
  )

  let missing = app.handle(dram::Request::new("GET", "/api/missing"))
  try testing::assert(missing.status == 404, "missing grouped route did not return 404")
  try testing::assert(missing.headers.get("X-Order").or("") == "global,", "group middleware ran for 404")
  let wrong_method = app.handle(dram::Request::new("POST", "/api/after"))
  try testing::assert(wrong_method.status == 405, "grouped route did not return 405")
  try testing::assert(
    wrong_method.headers.get("X-Order").or("") == "global,",
    "group middleware ran for 405",
  )
  testing::pass()
}

test fn copied_groups_isolate_middleware_snapshots() Void!Str {
  mut app = dram::App::new()
  mut base = app.group("/copy")
  base.use(order_middleware("one,"))
  base.use(order_middleware("two,"))
  base.use(order_middleware("three,"))

  mut left = base
  mut right = base
  left.use(order_middleware("left,"))
  right.use(order_middleware("right,"))
  left.get(
    "/left",
    fn(request, response) {
      response.text(200, "left")
    },
  )
  right.get(
    "/right",
    fn(request, response) {
      response.text(200, "right")
    },
  )

  let left_response = app.handle(dram::Request::new("GET", "/copy/left"))
  try testing::assert(
    left_response.headers.get("X-Order").or("") == "one,two,three,left,",
    "right group overwrote left middleware",
  )
  let right_response = app.handle(dram::Request::new("GET", "/copy/right"))
  try testing::assert(
    right_response.headers.get("X-Order").or("") == "one,two,three,right,",
    "left group overwrote right middleware",
  )
  testing::pass()
}

test fn groups_validate_prefixes_paths_and_combined_conflicts() Void!Str {
  mut app = dram::App::new()
  mut api = app.group("/api")
  api.get("/users", fn(request, response) {})

  let parameter_prefix = unsafe {
    app.group("/orgs/:id")
  }
  try testing::assert(parameter_prefix.is_err(), "parameterized group prefix was accepted")
  let catch_all_prefix = unsafe {
    app.group("/files/*path")
  }
  try testing::assert(catch_all_prefix.is_err(), "catch-all group prefix was accepted")
  let trailing_slash = unsafe {
    app.group("/api/")
  }
  try testing::assert(trailing_slash.is_err(), "trailing group slash was accepted")
  let relative_prefix = unsafe {
    app.group("api")
  }
  try testing::assert(relative_prefix.is_err(), "relative group prefix was accepted")
  let relative_route = unsafe {
    api.get("users", fn(request, response) {})
  }
  try testing::assert(relative_route.is_err(), "relative grouped route was accepted")
  let conflict = unsafe {
    app.get("/api/users", fn(request, response) {})
  }
  try testing::assert(conflict.is_err(), "combined grouped route bypassed conflict detection")
  testing::pass()
}

test fn middleware_short_circuits_by_omitting_next() Void!Str {
  mut app = dram::App::new()
  app.use(
    fn(request: dram::Request, response: mut dram::Response, next: dram::Next) {
      response.text(401, "Unauthorized")
    },
  )
  app.get(
    "/private",
    fn(request: dram::Request, response: mut dram::Response) {
      response.text(200, "should not run")
    },
  )

  let response = app.handle(dram::Request::new("GET", "/private"))
  try testing::assert(response.status == 401, "short circuit did not preserve middleware status")
  try testing::assert(Str::from(response.body) == "Unauthorized", "short-circuited route still ran")
  testing::pass()
}

test fn context_values_propagate_without_key_collisions() Void!Str {
  let first_key = ValueKey{id: 1}
  let second_key = ValueKey{id: 2}
  mut app = dram::App::new()
  app.use(
    fn(request: dram::Request, response: mut dram::Response, next: dram::Next) {
      let derived = request_context::with_value(request.context(), first_key, "first")
      next.run(request.with_context(derived), response)
    },
  )
  app.get(
    "/values",
    fn(request: dram::Request, response: mut dram::Response) {
      let first = str_value(request, first_key).or("missing")
      let second = str_value(request, second_key).or("missing")
      response.text(200, "{request.path}:{first}:{second}")
    },
  )

  let response = app.handle(dram::Request::new("GET", "/values"))
  try testing::assert(
    Str::from(response.body) == "/values:first:missing",
    "context value or request propagation failed",
  )
  testing::pass()
}

test fn in_memory_request_constructor_uses_background() Void!Str {
  mut app = dram::App::new()
  app.get(
    "/context",
    fn(request: dram::Request, response: mut dram::Response) {
      let ctx = request.context()
      let done: Receiver<Void> = request_context::done(ctx)
      let context_error = request_context::err(ctx)
      response.header("X-Cancelled", context_error.is_some().to_str())
      response.header("X-Error", context_error.or("none"))
      response.header("X-Deadline", request_context::deadline(ctx).is_some().to_str())
      response.text(200, "context")
    },
  )
  let response = app.handle(dram::Request::new("GET", "/context"))
  try testing::assert(response.headers.get("X-Cancelled").or("") == "false", "background was cancelled")
  try testing::assert(response.headers.get("X-Error").or("") == "none", "background had an error")
  try testing::assert(response.headers.get("X-Deadline").or("") == "false", "background had a deadline")
  testing::pass()
}

test fn json_helper_buffers_encoded_values_and_recovers_encoding_failures() Void!Str {
  mut app = dram::App::new()
  app.get(
    "/json",
    fn(request, response) {
      response.json(201, JsonPayload{message: "hello", count: 2})
    },
  )
  app.get(
    "/bad-json",
    fn(request, response) {
      response.text(202, "partial")
      response.json(200, fn() {})
    },
  )

  let encoded = app.handle(dram::Request::new("GET", "/json"))
  try testing::assert(encoded.status == 201, "JSON helper status changed")
  try testing::assert(
    encoded.headers.get("Content-Type").or("") == "application/json; charset=utf-8",
    "JSON content type changed",
  )
  let encoded_body = Str::from(encoded.body)
  let expected_message_first = "\{\"message\":\"hello\",\"count\":2\}"
  let expected_count_first = "\{\"count\":2,\"message\":\"hello\"\}"
  try testing::assert(
    encoded_body == expected_message_first or encoded_body == expected_count_first,
    "JSON body changed: {encoded_body}",
  )

  let head = app.handle(dram::Request::new("HEAD", "/json"))
  try testing::assert(
    head.status == 201 and head.body.size() == 0,
    "HEAD JSON response retained its body",
  )
  try testing::assert(head.headers.get("Content-Length").or("0") != "0", "HEAD JSON length was lost")

  let failed = app.handle(dram::Request::new("GET", "/bad-json"))
  try testing::assert(failed.status == 500, "JSON encoding failure did not recover")
  try testing::assert(Str::from(failed.body) == "Internal Server Error", "JSON error exposed details")
  testing::pass()
}

test fn post_can_read_headers_and_return_buffered_bytes() Void!Str {
  mut app = dram::App::new()
  app.post(
    "/echo",
    fn(request: dram::Request, response: mut dram::Response) {
      response.header("X-Seen", request.header("X-Test").or("missing"))
      response.bytes(201, request.body)
    },
  )
  mut headers = dram::Headers::new()
  headers.set("x-test", "present")
  mut request = dram::Request::new("POST", "/echo")
  request.headers = headers
  request.body = "bytes".bytes()

  let response = app.handle(request)
  try testing::assert(response.status == 201, "POST route did not return 201")
  try testing::assert(Str::from(response.body) == "bytes", "byte response changed")
  try testing::assert(response.headers.get("X-Seen").or("") == "present", "request header missing")
  try testing::assert(
    response.headers.get("Content-Type").or("") == "application/octet-stream",
    "byte response content type changed",
  )
  testing::pass()
}

test fn headers_preserve_repeated_values_and_own_framing() Void!Str {
  mut headers = dram::Headers::new()
  headers.add("set-cookie", "a=1")
  headers.add("Set-Cookie", "b=2")
  try testing::assert(headers.values("SET-COOKIE").size() == 2, "repeated values collapsed")

  mut app = dram::App::new()
  app.get(
    "/framing",
    fn(request: dram::Request, response: mut dram::Response) {
      response.header("Content-Length", "1")
      response.header("Transfer-Encoding", "chunked")
      response.header("Trailer", "X-Later")
      response.status = 200
      response.body = "hello".bytes()
    },
  )
  let response = app.handle(dram::Request::new("GET", "/framing"))
  try testing::assert(response.headers.get("Content-Length").or("") == "5", "content length not replaced")
  try testing::assert(response.headers.get("Transfer-Encoding").is_none(), "transfer encoding retained")
  try testing::assert(response.headers.get("Trailer").is_none(), "trailer retained")
  testing::pass()
}

test fn header_values_reject_controls_but_allow_htab() Void!Str {
  mut headers = dram::Headers::new()
  headers.set("X-Tab", "left\tright")
  try testing::assert(headers.get("x-tab").or("") == "left\tright", "HTAB was rejected")
  let invalid = unsafe {
    headers.set("X-Control", "bad\x01value")
  }
  try testing::assert(invalid.is_err(), "control character was accepted")
  testing::pass()
}

test fn body_limit_returns_413_before_dispatch() Void!Str {
  mut app = dram::App::new()
  app.set_max_body_bytes(4)
  app.post(
    "/upload",
    fn(request: dram::Request, response: mut dram::Response) {
      response.text(200, "should not run")
    },
  )
  mut request = dram::Request::new("POST", "/upload")
  request.body = "large".bytes()

  let response = app.handle(request)
  try testing::assert(response.status == 413, "oversized request did not return 413")
  testing::pass()
}

test fn head_falls_back_to_get_and_prefers_explicit_head() Void!Str {
  mut app = dram::App::new()
  app.get(
    "/resource",
    fn(request: dram::Request, response: mut dram::Response) {
      response.header("X-Handler", "GET")
      response.text(200, "get body")
    },
  )
  let fallback = app.handle(dram::Request::new("HEAD", "/resource"))
  try testing::assert(fallback.status == 200 and fallback.body.size() == 0, "HEAD fallback failed")
  try testing::assert(fallback.headers.get("Content-Length").or("") == "8", "HEAD length changed")

  app.head(
    "/resource",
    fn(request: dram::Request, response: mut dram::Response) {
      response.header("X-Handler", "HEAD")
      response.text(202, "head body")
    },
  )
  let explicit = app.handle(dram::Request::new("HEAD", "/resource"))
  try testing::assert(explicit.status == 202 and explicit.body.size() == 0, "explicit HEAD failed")
  try testing::assert(explicit.headers.get("X-Handler").or("") == "HEAD", "explicit HEAD not preferred")
  testing::pass()
}

test fn finalization_rejects_unsupported_statuses_and_connect() Void!Str {
  mut app = dram::App::new()
  app.get(
    "/reset",
    fn(request: dram::Request, response: mut dram::Response) {
      response.text(205, "suppressed")
    },
  )
  app.get(
    "/informational",
    fn(request: dram::Request, response: mut dram::Response) {
      response.text(103, "unsupported")
    },
  )
  app.route(
    "CONNECT",
    "/tunnel",
    fn(request: dram::Request, response: mut dram::Response) {
      response.text(200, "buffered tunnel")
    },
  )
  let reset = app.handle(dram::Request::new("GET", "/reset"))
  try testing::assert(reset.status == 205 and reset.body.size() == 0, "205 body retained")
  let informational = app.handle(dram::Request::new("GET", "/informational"))
  try testing::assert(informational.status == 500, "1xx final status accepted")
  let connect = app.handle(dram::Request::new("CONNECT", "/tunnel"))
  try testing::assert(connect.status == 500, "buffered CONNECT accepted")
  testing::pass()
}

test fn custom_methods_and_duplicate_validation() Void!Str {
  mut app = dram::App::new()
  app.route(
    "M-SEARCH",
    "/discover",
    fn(request: dram::Request, response: mut dram::Response) {
      response.text(200, "found")
    },
  )
  try testing::assert(
    app.handle(dram::Request::new("M-SEARCH", "/discover")).status == 200,
    "custom failed",
  )
  try testing::assert(
    app.handle(dram::Request::new("m-search", "/discover")).status == 405,
    "case changed",
  )
  let duplicate = unsafe {
    app.route("M-SEARCH", "/discover", fn(request: dram::Request, response: mut dram::Response) {})
  }
  try testing::assert(duplicate.is_err(), "duplicate route did not panic")
  testing::pass()
}

test fn next_is_one_shot() Void!Str {
  mut app = dram::App::new()
  app.use(
    fn(request: dram::Request, response: mut dram::Response, next: dram::Next) {
      next.run(request, response)
      next.run(request, response)
    },
  )
  app.get(
    "/once",
    fn(request: dram::Request, response: mut dram::Response) {
      response.body = "{Str::from(response.body)}route".bytes()
      response.status = 200
    },
  )
  let response = app.handle(dram::Request::new("GET", "/once"))
  try testing::assert(Str::from(response.body) == "route", "Next replayed the route")
  testing::pass()
}

test fn app_converts_to_an_isolated_standard_handler_snapshot() Void!Str {
  mut app = dram::App::new()
  app.set_max_body_bytes(8)
  app.use(
    fn(request, response, next) {
      response.header("X-Snapshot", "before")
      next.run(request, response)
    },
  )
  app.not_found(
    fn(request, response) {
      response.text(404, "old fallback")
    },
  )
  app.get(
    "/before",
    fn(request, response) {
      response.text(200, "before")
    },
  )
  app.post(
    "/body",
    fn(request, response) {
      response.text(200, Str::from(request.body))
    },
  )

  let handler: http::Handler = app
  let server = http::Server{Addr: "127.0.0.1:0", Handler: app}

  app.set_max_body_bytes(1)
  app.use(
    fn(request, response, next) {
      response.header("X-Snapshot", "after")
      next.run(request, response)
    },
  )
  app.not_found(
    fn(request, response) {
      response.text(404, "new fallback")
    },
  )
  app.get(
    "/after",
    fn(request, response) {
      response.text(200, "after")
    },
  )

  let before = serve_test_request(handler, "GET", "/before", "")
  try testing::assert(before.Code == 200, "snapshot lost its registered route")
  try testing::assert(before.Body.String() == "before", "snapshot route response changed")
  try testing::assert(before.Header().Get("X-Snapshot") == "before", "snapshot middleware changed")

  let after = serve_test_request(handler, "GET", "/after", "")
  try testing::assert(after.Code == 404, "snapshot observed a later route")
  try testing::assert(after.Body.String() == "old fallback", "snapshot fallback changed")

  let body = serve_test_request(handler, "POST", "/body", "four")
  try testing::assert(body.Code == 200, "snapshot body limit changed")
  try testing::assert(body.Body.String() == "four", "snapshot request body changed")
  testing::pass()
}

test fn mutable_http_handler_reference_observes_later_registration() Void!Str {
  mut app = dram::App::new()
  let handler: http::Handler = mut app
  app.get(
    "/later",
    fn(request, response) {
      response.text(200, "later")
    },
  )

  let response = serve_test_request(handler, "GET", "/later", "")
  try testing::assert(response.Code == 200, "mutable handler reference stopped sharing configuration")
  testing::pass()
}

test fn listen_rejects_invalid_ports_before_binding() Void!Str {
  let app = dram::App::new()
  match app.listen(-1) {
    ok => testing::fail("negative port unexpectedly listened"),
    err(message) => testing::assert(message == "port must be between 0 and 65535", "error changed"),
  }
}

test fn panic_replaces_partial_response() Void!Str {
  mut app = dram::App::new()
  app.get(
    "/panic",
    fn(request: dram::Request, response: mut dram::Response) {
      response.status = 204
      response.header("X-Partial", "secret")
      response.body = "sensitive".bytes()
      panic("boom")
    },
  )
  let response = app.handle(dram::Request::new("GET", "/panic"))
  try testing::assert(response.status == 500, "panic was not recovered")
  try testing::assert(Str::from(response.body) == "Internal Server Error", "partial body retained")
  try testing::assert(response.headers.get("X-Partial").is_none(), "partial headers retained")
  testing::pass()
}
