use ard/async
use ard/unsafe

use go:bytes
use go:compress/gzip
use go:context as go_context
use dram/context as request_context
use go:encoding/json
use go:errors
use go:fmt
use go:io
use go:net
use go:net/http
use go:net/url
use go:os
use go:os/signal
use go:runtime/debug
use go:strconv
use go:strings
use go:sync
use go:syscall
use go:time

let DEFAULT_MAX_BODY_BYTES = 1_048_576
let DEFAULT_MAX_HEADER_BYTES = DEFAULT_MAX_BODY_BYTES
let DEFAULT_SHUTDOWN_TIMEOUT_MS = 10_000
let DEFAULT_COMPRESSION_MIN_BYTES = 1024
let GZIP_CACHE_ENTRIES = 512

private fn error_message(error: Error) Str {
  error.error()
}

struct Headers {
  _raw: http::Header,
}

fn Headers::new() Headers {
  Headers{_raw: [:]}
}

impl Headers {
  fn get(name: Str) Str? {
    self._raw.Values(name).at(0)
  }

  fn values(name: Str) [Str] {
    let copied: &mut [Str] = &mut []
    for value in self._raw.Values(name) {
      copied.push(value)
    }
    copied.*
  }

  fn names() [Str] {
    let copied: &mut [Str] = &mut []
    for name in self._raw.keys() {
      copied.push(name)
    }
    copied.*
  }

  fn mut set(name: Str, value: Str) {
    validate_header(name, value)
    self._raw.Set(name, value)
  }

  fn mut add(name: Str, value: Str) {
    validate_header(name, value)
    self._raw.Add(name, value)
  }

  fn mut delete(name: Str) {
    self._raw.Del(name)
  }

  fn clone() Headers {
    Headers{_raw: self._raw.Clone()}
  }
}

struct Request {
  method: Str,
  path: Str,
  raw_query: Str,
  headers: Headers,
  body: [Byte],
  context: go_context::Context,
  path_params: [Str: Str],
  // The `Host` the client addressed (Go removes it from the headers).
  // Set for network requests; none for `Request::new`.
  host: Str?,
}

fn Request::new(method: Str, path: Str) Request {
  let target = parse_request_target(path)
  Request{
    method: method,
    path: target.path,
    raw_query: target.raw_query,
    headers: Headers::new(),
    body: [],
    context: request_context::background(),
    path_params: [:],
  }
}

impl Request {
  fn param(name: Str) Str? {
    self.path_params.get(name)
  }

  fn query(name: Str) Str? {
    self.query_list(name).at(0)
  }

  fn query_list(name: Str) [Str] {
    parse_query_values(self.raw_query, name)
  }

  // The first cookie named `name`, parsed leniently like Go's
  // `Request.Cookie`: a malformed pair does not hide the others.
  fn cookie(name: Str) Str? {
    let raw = &mut http::Request{Header: self.headers._raw}
    match raw.Cookie(name) {
      ok(found) => Maybe::new(found.Value),
      err(_) => Maybe::new(),
    }
  }

  // Every request cookie by name. For a repeated name the first wins,
  // matching `cookie(name)`.
  fn cookies() [Str: Str] {
    let raw = &mut http::Request{Header: self.headers._raw}
    let found: &mut [Str: Str] = &mut [:]
    for parsed in raw.Cookies() {
      if not found.has(parsed.Name) {
        found.set(parsed.Name, parsed.Value)
      }
    }
    found.*
  }

  fn with_context(context: go_context::Context) Request {
    Request{
      method: self.method,
      path: self.path,
      raw_query: self.raw_query,
      headers: self.headers,
      body: self.body,
      context: context,
      path_params: self.path_params,
      host: self.host,
    }
  }

  // Whether the `Server` that accepted this request has begun shutting
  // down. Always false for in-memory requests and for apps served by an
  // application-owned `http.Server`.
  fn draining() Bool {
    match drain_signal(self.context) {
      drain => request_context::err(drain.context).is_some(),
      _ => false,
    }
  }
}

// A panic recovered while serving a request. `message` and `stack` are for
// logs; clients only ever see a generic 500 or a closed stream.
struct Panic {
  method: Str,
  path: Str,
  message: Str,
  stack: Str,
}

type PanicObserver = fn(Panic)

// One request served over HTTP, reported after delivery finishes. For SSE
// responses that is when the stream ends, so `duration` covers the stream's
// lifetime. `status` is 0 when nothing was written (e.g. the client left
// before an event stream committed).
struct Completion {
  method: Str,
  path: Str,
  status: Int,
  bytes: Int,
  duration: time::Duration,
}

type CompletionObserver = fn(Completion)

private struct ServeOptions {
  panic: PanicObserver?,
  complete: CompletionObserver?,
  compression: Compression?,
  security: Headers?,
  cross_origin: CrossOrigin?,
  redirect_trailing_slash: Bool,
}

// Report a recovered panic to the observer, or to stderr without one.
private fn report_panic(options: ServeOptions, report: Panic) {
  match options.panic {
    observer => observer(report),
    _ => {
      fmt::Fprintf(
        os::Stderr,
        "dram: panic serving %s %s: %s\n%s\n",
        report.method,
        report.path,
        report.message,
        report.stack,
      )
    },
  }
}

private struct PanicTrace {
  completed: Bool,
  stack: Str,
}

// Run `body`, recording the goroutine stack if it panics. The deferred
// capture runs while the panic is still unwinding, so the stack includes
// the panic site; the caller's `unsafe` block recovers afterwards.
private fn trace_panics(trace: &mut PanicTrace, body: fn() $T) $T {
  defer {
    if not trace.completed {
      trace.stack = Str::from(debug::Stack())
    }
  }
  let value = body()
  trace.completed = true
  value
}

private struct DrainKey {
  marker: Int,
}

private struct DrainSignal {
  context: go_context::Context,
}

private fn drain_key() DrainKey {
  DrainKey{marker: 0}
}

private fn drain_signal(context: go_context::Context) DrainSignal? {
  match request_context::value(context, drain_key()) {
    boxed => unsafe::cast<DrainSignal>(boxed),
    _ => Maybe::new(),
  }
}

private enum ResponseMode {
  Buffered,
  SSE,
}

type SSEHandler = fn(&mut EventStream)

private struct ResponseState {
  mode: ResponseMode,
  sse_handler: SSEHandler?,
  context: go_context::Context?,
  // Set by the innermost `security_headers`, so outer instances leave
  // the response to the more specific policy.
  secured: Bool?,
}

struct Response {
  status: Int,
  headers: Headers,
  body: [Byte],
  _store: Any,
}

fn Response::new() Response {
  let state = &mut ResponseState{mode: ResponseMode::Buffered}
  Response{
    status: 404,
    headers: Headers::new(),
    body: [],
    _store: state,
  }
}

impl Response {
  fn mut text(status: Int, body: Str) {
    select_buffered(self)
    self.status = status
    self.headers.set("Content-Type", "text/plain; charset=utf-8")
    self.body = body.bytes()
  }

  fn mut bytes(status: Int, body: [Byte]) {
    self.data(status, "application/octet-stream", body)
  }

  fn mut data(status: Int, content_type: Str, body: [Byte]) {
    select_buffered(self)
    self.status = status
    self.headers.set("Content-Type", content_type)
    self.body = body
  }

  fn mut json(status: Int, value: Any) {
    match json::Marshal(value) {
      ok(body) => self.data(status, "application/json; charset=utf-8", body),
      err(message) => panic("failed to encode JSON response: {message}"),
    }
  }

  // Add a `Set-Cookie` header. Defaults: `Path=/`, `HttpOnly`,
  // `SameSite=Lax`, not `Secure`, and a browser-session lifetime. Each call
  // adds a header, so several cookies coexist. Invalid names, values, or
  // attribute combinations panic.
  fn mut set_cookie(
    name: Str,
    value: Str,
    max_age: Int?,
    expires: time::Time?,
    path: Str?,
    domain: Str?,
    secure: Bool?,
    http_only: Bool?,
    same_site: SameSite?,
  ) {
    let seconds = max_age.or(0)
    if max_age.is_some() and seconds <= 0 {
      panic("cookie {name}: max_age must be positive; use clear_cookie to remove a cookie")
    }
    add_cookie(
      self,
      name,
      value,
      seconds,
      expires.or(time::Time{}),
      path.or("/"),
      domain.or(""),
      secure.or(false),
      http_only.or(true),
      same_site.or(SameSite::lax),
    )
  }

  // Add a `Set-Cookie` header that removes `name`. `path` and `domain` must
  // match the ones the cookie was set with. `__Secure-` and `__Host-`
  // cookies are cleared with `Secure`, as browsers require.
  fn mut clear_cookie(name: Str, path: Str?, domain: Str?) {
    add_cookie(
      self,
      name,
      "",
      -1,
      time::Unix(Int64::from(0), Int64::from(0)),
      path.or("/"),
      domain.or(""),
      has_secure_cookie_prefix(name),
      true,
      SameSite::lax,
    )
  }

  // Replace the response with an empty-bodied redirect. `status` defaults
  // to 303 and must be 301, 302, 303, 307, or 308. `location` must be a
  // same-origin path (see `local_path`) unless `external` is true.
  fn mut redirect(location: Str, status: Int?, external: Bool?) {
    let code = status.or(303)
    if code != 301 and code != 302 and code != 303 and code != 307 and code != 308 {
      panic("redirect status must be 301, 302, 303, 307, or 308: {code}")
    }
    if location == "" or has_control_character(location) {
      panic("invalid redirect location: {strconv::Quote(location)}")
    }
    if (not external.or(false)) and local_path(location).is_none() {
      panic(
        "redirect location is not a local path; pass external: true to leave the site: {strconv::Quote(location)}",
      )
    }
    self.text(code, "")
    self.headers.set("Location", location)
  }

  fn mut sse(handler: SSEHandler) {
    let state = response_state(self.*)
    state.mode = ResponseMode::SSE
    state.sse_handler = Maybe::new(handler)
    self.status = 200
    self.headers.set("Content-Type", "text/event-stream")
    self.headers.set("Cache-Control", "no-cache")
    self.headers.set("X-Content-Type-Options", "nosniff")
    self.body = []
  }
}

// The `SameSite` attribute of a cookie. `none` requires `secure: true`.
enum SameSite {
  lax,
  strict,
  none,
}

private fn add_cookie(
  response: &mut Response,
  name: Str,
  value: Str,
  max_age: Int,
  expires: time::Time,
  path: Str,
  domain: Str,
  secure: Bool,
  http_only: Bool,
  same_site: SameSite,
) {
  if not valid_token(name) {
    panic("invalid cookie name: {strconv::Quote(name)}")
  }
  // RFC 6265 cookie-octets: printable ASCII except space, '"', ',', ';',
  // and '\', so values never need quoting.
  for character in value.runes() {
    if character <= ' ' or character >= '\x7f' or strings::Contains("\",;\\", character.to_str()) {
      panic("invalid character in value of cookie {name}; encode the value (e.g. hex or base64)")
    }
  }
  if (not strings::HasPrefix(path, "/")) or strings::Contains(path, ";") or has_control_character(path) {
    panic("cookie {name}: path must start with '/' and contain no ';' or control characters")
  }
  if same_site == SameSite::none and not secure {
    panic("cookie {name}: SameSite=None requires secure: true")
  }
  if has_secure_cookie_prefix(name) and not secure {
    panic("cookie {name}: __Secure- and __Host- cookies require secure: true")
  }
  if strings::HasPrefix(name, "__Host-") and (path != "/" or domain != "") {
    panic("cookie {name}: __Host- cookies require path \"/\" and no domain")
  }
  let site = match same_site {
    SameSite::lax => http::SameSiteLaxMode,
    SameSite::strict => http::SameSiteStrictMode,
    SameSite::none => http::SameSiteNoneMode,
  }
  let cookie = &mut http::Cookie{
    Name: name,
    Value: value,
    Path: path,
    Domain: domain,
    Expires: expires,
    MaxAge: max_age,
    Secure: secure,
    HttpOnly: http_only,
    SameSite: site,
  }
  match cookie.Valid() {
    ok => (),
    err(problem) => panic("invalid cookie {name}: {problem.error()}"),
  }
  response.headers.add("Set-Cookie", cookie.String())
}

private fn has_secure_cookie_prefix(name: Str) Bool {
  strings::HasPrefix(name, "__Secure-") or strings::HasPrefix(name, "__Host-")
}

private fn has_control_character(value: Str) Bool {
  mut found = false
  for character in value.runes() {
    if character < ' ' or character == '\x7f' {
      found = true
    }
  }
  found
}

// `target` if it is a same-origin absolute path such as `/settings?tab=1`,
// otherwise none. Rejects scheme-relative `//host`, `/\host`, backslashes,
// and control characters, which browsers strip or treat as `/`. Use it to
// check redirect targets taken from requests, e.g. `?next=`.
fn local_path(target: Str) Str? {
  let second = target.runes().at(1).or('a')
  let local = strings::HasPrefix(target, "/") and second != '/' and (not strings::Contains(target, "\\")) and (not has_control_character(target))
  if local {
    Maybe::new(target)
  } else {
    Maybe::new()
  }
}

// How `security_headers` restricts framing by other sites.
enum Framing {
  same_origin,
  deny,
  allow,
}

// Middleware that adds defensive response headers after the rest of the
// chain runs, without replacing any header the response already has. When
// several are registered (e.g. globally and on a group), the innermost one
// that runs decides the response's policy and outer ones add nothing:
//
// - `X-Content-Type-Options: nosniff`;
// - for `same_origin` (default) `X-Frame-Options: SAMEORIGIN` and
//   `frame-ancestors 'self'`; for `deny`, `DENY` and `'none'`; `allow`
//   sends neither;
// - `Referrer-Policy`, default `strict-origin-when-cross-origin` ("" omits);
// - `Content-Security-Policy`: `csp`, plus the frame-ancestors directive
//   when `csp` has none, or just that directive without `csp`;
// - `Strict-Transport-Security: max-age=N` only when `hsts_max_age` is set.
fn security_headers(
  frame: Framing?,
  referrer_policy: Str?,
  csp: Str?,
  hsts_max_age: Int?,
  hsts_include_subdomains: Bool?,
) Middleware {
  let fixed = security_policy(frame, referrer_policy, csp, hsts_max_age, hsts_include_subdomains)
  fn(request: Request, response: &mut Response, next: Next) {
    next.run(request, response)
    let state = response_state(response.*)
    if not state.secured.or(false) {
      state.secured = Maybe::new(true)
      fill_headers(response, fixed)
    }
  }
}

private fn security_policy(
  frame: Framing?,
  referrer_policy: Str?,
  csp: Str?,
  hsts_max_age: Int?,
  hsts_include_subdomains: Bool?,
) Headers {
  let framing = frame.or(Framing::same_origin)
  let defaults = &mut Headers::new()
  defaults.set("X-Content-Type-Options", "nosniff")
  let ancestors = match framing {
    Framing::same_origin => "frame-ancestors 'self'",
    Framing::deny => "frame-ancestors 'none'",
    Framing::allow => "",
  }
  match framing {
    Framing::same_origin => defaults.set("X-Frame-Options", "SAMEORIGIN"),
    Framing::deny => defaults.set("X-Frame-Options", "DENY"),
    Framing::allow => (),
  }
  let policy = strings::TrimSpace(strings::TrimSuffix(strings::TrimSpace(csp.or("")), ";"))
  if policy == "" {
    if ancestors != "" {
      defaults.set("Content-Security-Policy", ancestors)
    }
  } else if ancestors == "" or has_csp_directive(policy, "frame-ancestors") {
    defaults.set("Content-Security-Policy", policy)
  } else {
    defaults.set("Content-Security-Policy", "{policy}; {ancestors}")
  }
  let referrer = referrer_policy.or("strict-origin-when-cross-origin")
  if referrer != "" {
    defaults.set("Referrer-Policy", referrer)
  }
  match hsts_max_age {
    seconds => {
      if seconds < 0 {
        panic("hsts_max_age cannot be negative: {seconds}")
      }
      mut subdomains = ""
      if hsts_include_subdomains.or(false) {
        subdomains = "; includeSubDomains"
      }
      defaults.set("Strict-Transport-Security", "max-age={seconds}{subdomains}")
    },
    _ => (),
  }
  defaults.clone()
}

private fn fill_headers(response: &mut Response, fixed: Headers) {
  for name in fixed.names() {
    if response.headers.get(name).is_none() {
      response.headers.set(name, fixed.get(name).or(""))
    }
  }
}

// The app-level security header policy, applied at delivery to every
// response that no `security_headers` middleware has handled.
private fn apply_security_defaults(response: Response, options: ServeOptions) Response {
  match options.security {
    fixed => {
      mut response = response
      let secured = &mut response
      if not response_state(response).secured.or(false) {
        fill_headers(secured, fixed)
      }
      secured.*
    },
    _ => response,
  }
}

private struct SecuritySettings {
  enabled: Bool,
  headers: Headers,
}

private fn security_settings(stored: Any?) Headers? {
  match stored {
    boxed => {
      let settings = unsafe::cast<SecuritySettings>(
        boxed,
      ).expect("invalid internal security settings")
      match settings.enabled {
        true => Maybe::new(settings.headers),
        false => Maybe::new(),
      }
    },
    _ => {
      Maybe::new(
        security_policy(Maybe::new(), Maybe::new(), Maybe::new(), Maybe::new(), Maybe::new()),
      )
    },
  }
}

private struct CrossOrigin {
  enabled: Bool,
  trusted: [Str],
}

private fn cross_origin_settings(stored: Any?) CrossOrigin? {
  match stored {
    boxed => {
      let settings = unsafe::cast<CrossOrigin>(
        boxed,
      ).expect("invalid internal cross-origin settings")
      match settings.enabled {
        true => Maybe::new(settings),
        false => Maybe::new(),
      }
    },
    _ => Maybe::new(CrossOrigin{enabled: true, trusted: []}),
  }
}

// Go's `http.CrossOriginProtection` check: unsafe browser requests must be
// same-origin (by `Sec-Fetch-Site`, else by `Origin` against the request
// host) or come from a trusted origin. Requests without either header are
// not from a browser and pass.
private fn cross_origin_rejected(request: Request, settings: CrossOrigin) Bool {
  let method = request.method
  if method == "GET" or method == "HEAD" or method == "OPTIONS" {
    false
  } else {
    let site = strings::ToLower(strings::TrimSpace(request.headers.get("Sec-Fetch-Site").or("")))
    let origin = request.headers.get("Origin").or("")
    if site == "same-origin" or site == "none" {
      false
    } else if site != "" {
      not origin_trusted(origin, settings)
    } else if origin == "" {
      false
    } else if origin_host(origin) != "" and strings::EqualFold(origin_host(origin), request.host.or("")) {
      false
    } else {
      not origin_trusted(origin, settings)
    }
  }
}

private fn origin_host(origin: Str) Str {
  match url::Parse(origin) {
    ok(parsed) => parsed.Host,
    err(_) => "",
  }
}

private fn origin_trusted(origin: Str, settings: CrossOrigin) Bool {
  list_contains(settings.trusted, strings::ToLower(strings::TrimSpace(origin)))
}

private fn normalize_trusted_origin(origin: Str) Str {
  let invalid = "trusted origin must be scheme://host[:port] with no path, query, or fragment: {strconv::Quote(origin)}"
  match url::Parse(origin) {
    ok(parsed) => {
      if parsed.Scheme == "" or parsed.Host == "" or parsed.Path != "" or parsed.Opaque != "" or strings::ContainsAny(origin, "?#@") {
        panic(invalid)
      }
      strings::ToLower(origin)
    },
    err(_) => panic(invalid),
  }
}

private fn forbidden_cross_origin() Response {
  let response = &mut Response::new()
  response.text(403, "Forbidden: cross-origin request")
  response.*
}

private fn has_csp_directive(policy: Str, name: Str) Bool {
  mut found = false
  for directive in strings::Split(policy, ";") {
    let fields = strings::Fields(directive)
    if strings::EqualFold(fields.at(0).or(""), name) {
      found = true
    }
  }
  found
}

private fn response_state(response: Response) &mut ResponseState {
  unsafe::cast<&mut ResponseState>(response._store).expect("invalid internal response state")
}

private fn select_buffered(response: &mut Response) {
  let state = response_state(response.*)
  if state.mode == ResponseMode::SSE {
    response.headers.delete("Content-Type")
    response.headers.delete("Cache-Control")
    response.headers.delete("X-Content-Type-Options")
  }
  state.mode = ResponseMode::Buffered
  state.sse_handler = Maybe::new()
}

private struct EventStreamState {
  writer: http::ResponseWriter,
  context: go_context::Context,
  transport_context: go_context::Context,
  status: Int,
  headers: Headers,
  committed: Bool,
  usable: Bool,
  record: &mut DeliveryRecord,
}

// What actually reached the client, for `CompletionObserver`s.
private struct DeliveryRecord {
  status: Int,
  bytes: Int,
}

struct EventStream {
  store: Any,
}

impl EventStream {
  fn mut send(data: Str, event: Str?, id: Str?, retry_ms: Int?) Bool {
    validate_sse_name("event", event.or(""))
    validate_sse_name("id", id.or(""))

    if retry_ms.or(0) < 0 {
      panic("SSE retry milliseconds cannot be negative")
    }

    let fields: &mut [Str] = &mut []
    event.map(fn(value) {
      fields.push("event: {value}")
    })
    id.map(fn(value) {
      fields.push("id: {value}")
    })
    retry_ms.map(fn(value) {
      fields.push("retry: {value}")
    })

    for line in sse_lines(data) {
      fields.push("data: {line}")
    }
    self.write_and_flush("{strings::Join(fields, "\n")}\n\n")
  }

  fn mut comment(text: Str) Bool {
    let fields: &mut [Str] = &mut []
    for line in sse_lines(text) {
      fields.push(": {line}")
    }
    self.write_and_flush("{strings::Join(fields, "\n")}\n\n")
  }

  fn cancelled() Bool {
    let state = event_stream_state(&self)
    (not state.usable) or request_context::err(state.context).is_some() or request_context::err(state.transport_context).is_some()
  }

  // Receives (closes) when the stream should end: the client disconnected,
  // the request context was cancelled, or the server began shutting down.
  // Select on it while waiting for something to send.
  fn done() Receiver<Void> {
    request_context::done(event_stream_state(&self).context)
  }

  private fn mut write_and_flush(body: Str) Bool {
    let state = event_stream_state(self)
    if (not state.usable) or request_context::err(state.context).is_some() or request_context::err(state.transport_context).is_some() {
      state.usable = false
      false
    } else if not commit_event_stream(self) {
      false
    } else {
      let controller = http::NewResponseController(state.writer)
      match controller.SetWriteDeadline(time::Now().Add(30 * time::Second)) {
        ok => (),
        err(_) => (),
      }
      let written = match state.writer.Write(&mut body.bytes()) {
        err(_) => {
          state.usable = false
          -1
        },
        ok(count) => {
          state.record.bytes =+ count
          count
        },
      }
      let flushed = match written == body.bytes().size() {
        false => false,
        true => {
          match controller.Flush() {
            ok => true,
            err(_) => false,
          }
        },
      }
      match controller.SetWriteDeadline(time::Time{}) {
        ok => (),
        err(_) => (),
      }
      if not flushed {
        state.usable = false
      }
      flushed
    }
  }
}

private fn event_stream_state(stream: &EventStream) &mut EventStreamState {
  unsafe::cast<&mut EventStreamState>(stream.store).expect("invalid internal event stream state")
}

private fn commit_event_stream(stream: &mut EventStream) Bool {
  let state = event_stream_state(stream)
  if state.committed {
    true
  } else if (not state.usable) or request_context::err(state.context).is_some() or request_context::err(state.transport_context).is_some() {
    state.usable = false
    false
  } else {
    copy_http_headers(state.writer, state.headers)
    state.committed = true
    state.record.status = state.status
    state.writer.WriteHeader(state.status)
    true
  }
}

private fn validate_sse_name(field: Str, value: Str) {
  if strings::Contains(value, "\r") or strings::Contains(value, "\n") or strings::Contains(value, "\x00") {
    panic("SSE {field} cannot contain CR, LF, or NUL")
  }
}

private fn sse_lines(value: Str) [Str] {
  strings::Split(strings::ReplaceAll(strings::ReplaceAll(value, "\r\n", "\n"), "\r", "\n"), "\n")
}

type Handler = fn(Request, &mut Response)
type Middleware = fn(Request, &mut Response, Next)

private struct NextState {
  callback: fn(Request, &mut Response),
  ran: Bool,
}

struct Next {
  store: Any,
}

impl Next {
  fn run(request: Request, response: &mut Response) {
    let state = unsafe::cast<&mut NextState>(
      self.store,
    ).expect("invalid internal middleware continuation")
    if not state.ran {
      state.ran = true
      state.callback(request, response)
    }
  }
}

struct RouteSegment {
  value: Str,
  name: Str?,
}

struct Route {
  method: Str,
  path: Str,
  segments: [RouteSegment],
  middleware_handlers: [Middleware],
  handler: Handler,
  allow_cross_origin: Bool?,
}

struct App {
  middleware_handlers: [Middleware],
  routes: [Route],
  max_body_bytes: Int,
  _not_found_handler: Handler?,
  _method_not_allowed_handler: Handler?,
  _panic_observer: PanicObserver?,
  _completion_observer: CompletionObserver?,
  _compression: Any?,
  _security: Any?,
  _cross_origin: Any?,
  _redirect_trailing_slash: Bool?,
}

private struct FallbackHandlers {
  not_found: Handler?,
  method_not_allowed: Handler?,
}

impl http::Handler for App {
  fn serve_h_t_t_p(writer: http::ResponseWriter, raw_request: &mut http::Request) {
    let fallback_handlers = FallbackHandlers{
      not_found: self._not_found_handler,
      method_not_allowed: self._method_not_allowed_handler,
    }
    let options = ServeOptions{
      panic: self._panic_observer,
      complete: self._completion_observer,
      compression: compression_settings(self._compression),
      security: security_settings(self._security),
      cross_origin: cross_origin_settings(self._cross_origin),
      redirect_trailing_slash: self._redirect_trailing_slash.or(true),
    }
    serve_observed(
      self.middleware_handlers,
      self.routes,
      fallback_handlers,
      self.max_body_bytes,
      options,
      writer,
      raw_request,
    )
  }
}

fn App::new() App {
  let middleware_handlers: [Middleware] = []
  let routes: [Route] = []
  App{
    middleware_handlers: middleware_handlers,
    routes: routes,
    max_body_bytes: DEFAULT_MAX_BODY_BYTES,
    _not_found_handler: Maybe::new(),
    _method_not_allowed_handler: Maybe::new(),
    _panic_observer: Maybe::new(),
    _completion_observer: Maybe::new(),
    _compression: Maybe::new(),
    _security: Maybe::new(),
    _cross_origin: Maybe::new(),
    _redirect_trailing_slash: Maybe::new(true),
  }
}

impl App {
  fn mut set_max_body_bytes(max_body_bytes: Int) {
    if max_body_bytes < 0 {
      panic("max body bytes cannot be negative")
    }
    self.max_body_bytes = max_body_bytes
  }

  fn mut use(middleware: Middleware) {
    self.middleware_handlers.push(middleware)
  }

  fn mut not_found(handler: Handler) {
    self._not_found_handler = Maybe::new(handler)
  }

  fn mut method_not_allowed(handler: Handler) {
    self._method_not_allowed_handler = Maybe::new(handler)
  }

  // Observe panics recovered while serving requests, replacing the default
  // report on stderr. Clients still receive only a generic 500, or a closed
  // stream after an event stream has committed.
  fn mut on_panic(observer: PanicObserver) {
    self._panic_observer = Maybe::new(observer)
  }

  // Observe every request served over HTTP after its response has been
  // delivered, e.g. to write access logs. Not called by `App.handle`.
  fn mut on_complete(observer: CompletionObserver) {
    self._completion_observer = Maybe::new(observer)
  }

  // Gzip buffered responses when the client accepts it. Applies after all
  // middleware, at delivery, to responses with a body of at least
  // `min_bytes` (default 1024) whose media type is in `types` (default:
  // text/* except event streams, JSON, JavaScript, XML, SVG, WebAssembly,
  // and +json/+xml types; `type/*` entries match a whole type). Skips
  // responses that already have a Content-Encoding or whose Cache-Control
  // has no-transform. Adds `Vary: Accept-Encoding` and gives the gzip
  // representation its own ETag (`"tag"` becomes `"tag-gzip"`). Event
  // streams are never compressed.
  fn mut compress(min_bytes: Int?, types: [Str]?) {
    if min_bytes.or(0) < 0 {
      panic("compression min bytes cannot be negative")
    }
    self._compression = Maybe::new<Any>(
      Compression{
        min_bytes: min_bytes.or(DEFAULT_COMPRESSION_MIN_BYTES),
        types: types,
        cache: &mut GzipCache{lock: sync::Mutex{}, entries: [:]},
      },
    )
  }

  // Replace the app's security header policy, applied at delivery to every
  // response that no `security_headers` middleware handled. On by default
  // with the defaults below; `enabled: false` turns it off.
  fn mut security_headers(
    frame: Framing?,
    referrer_policy: Str?,
    csp: Str?,
    hsts_max_age: Int?,
    hsts_include_subdomains: Bool?,
    enabled: Bool?,
  ) {
    self._security = Maybe::new<Any>(
      SecuritySettings{
        enabled: enabled.or(true),
        headers: security_policy(frame, referrer_policy, csp, hsts_max_age, hsts_include_subdomains),
      },
    )
  }

  // Replace the cross-origin request protection settings. On by default
  // with no trusted origins; `enabled: false` turns it off. Trusted origins
  // are `scheme://host[:port]`.
  fn mut cross_origin_protection(trusted_origins: [Str]?, enabled: Bool?) {
    let trusted: &mut [Str] = &mut []
    for origin in trusted_origins.or([]) {
      trusted.push(normalize_trusted_origin(origin))
    }
    self._cross_origin = Maybe::new<Any>(CrossOrigin{enabled: enabled.or(true), trusted: trusted.*})
  }

  // Redirect a request whose path matches no route to the same path with
  // its trailing slash added or removed, when that path has a route for the
  // request's method. The redirect is a 308 that keeps the query string.
  // On by default; `enabled: false` restores exact matching.
  fn mut redirect_trailing_slash(enabled: Bool?) {
    self._redirect_trailing_slash = Maybe::new(enabled.or(true))
  }

  fn mut route(method: Str, path: Str, handler: Handler) {
    register_route(self, method, path, [], false, handler)
  }

  fn mut group(prefix: Str) Group {
    validate_group_prefix(prefix)
    Group{
      _app: self,
      _prefix: prefix,
      _middleware_handlers: [],
      _allow_cross_origin: Maybe::new(false),
    }
  }

  fn mut get(path: Str, handler: Handler) {
    self.route("GET", path, handler)
  }

  fn mut head(path: Str, handler: Handler) {
    self.route("HEAD", path, handler)
  }

  fn mut post(path: Str, handler: Handler) {
    self.route("POST", path, handler)
  }

  fn mut put(path: Str, handler: Handler) {
    self.route("PUT", path, handler)
  }

  fn mut patch(path: Str, handler: Handler) {
    self.route("PATCH", path, handler)
  }

  fn mut delete(path: Str, handler: Handler) {
    self.route("DELETE", path, handler)
  }

  fn mut options(path: Str, handler: Handler) {
    self.route("OPTIONS", path, handler)
  }

  fn mut trace(path: Str, handler: Handler) {
    self.route("TRACE", path, handler)
  }

  fn handle(request: Request) Response {
    let fallback_handlers = FallbackHandlers{
      not_found: self._not_found_handler,
      method_not_allowed: self._method_not_allowed_handler,
    }
    handle_bounded(
      self.middleware_handlers,
      self.routes,
      fallback_handlers,
      self.max_body_bytes,
      ServeOptions{
        panic: self._panic_observer,
        complete: Maybe::new(),
        compression: compression_settings(self._compression),
        security: security_settings(self._security),
        cross_origin: cross_origin_settings(self._cross_origin),
        redirect_trailing_slash: self._redirect_trailing_slash.or(true),
      },
      request,
    )
  }

  // Serve until SIGINT or SIGTERM, then shut down gracefully: stop
  // accepting, end event streams, and let in-flight requests finish within
  // 10 seconds. A second signal closes remaining connections immediately.
  // Returns ok after a graceful shutdown.
  fn listen(port: Int, host: Str?) Void!Str {
    let server = try self.bind(port: port, host: host)
    let signals = Chan::new<os::Signal>(2)
    signal::Notify(signals.sender(), os::Interrupt, syscall::SIGTERM)
    async::start(fn() {
      match signals.recv() {
        _first => {
          async::start(fn() {
            server.shutdown()
          })
          match signals.recv() {
            _second => server.close(),
            _ => Result::ok(()),
          }
        },
        _ => Result::ok(()),
      }
    })
    let result = server.serve()
    signal::Stop(signals.sender())
    signals.close()
    result
  }

  // Open a listener on `host:port` (host defaults to 127.0.0.1; port 0
  // picks a free port) for a `Server` that serves a snapshot of this app.
  // Binding happens now, so address errors are reported here and
  // `server.address()` is known before `serve`.
  fn bind(port: Int, host: Str?) Server!Str {
    if port < 0 or port > 65535 {
      Result::err("port must be between 0 and 65535")
    } else {
      let address = net::JoinHostPort(host.or("127.0.0.1"), strconv::Itoa(port))
      let listener = try net::Listen("tcp", address) -> error { Result::err(error.error()) }
      let drain, cancel_drain = go_context::WithCancel(go_context::Background())
      let base = request_context::with_value(
        go_context::Background(),
        drain_key(),
        DrainSignal{context: drain},
      )
      let server = &mut http::Server{}
      server.Handler = snapshot_app(self)
      server.BaseContext = fn(_listener: net::Listener) go_context::Context {
        base
      }
      server.ReadHeaderTimeout = 5 * time::Second
      server.ReadTimeout = 30 * time::Second
      server.WriteTimeout = 30 * time::Second
      server.IdleTimeout = 120 * time::Second
      server.MaxHeaderBytes = DEFAULT_MAX_HEADER_BYTES
      let state = &mut ServerState{
        server: server,
        listener: listener,
        cancel_drain: fn() {
          cancel_drain()
        },
        lock: sync::Mutex{},
        serving: false,
        stopping: false,
        stopped: Chan::new<Bool>(),
        failure: Maybe::new(),
      }
      Result::ok(Server{_store: state})
    }
  }
}

private fn snapshot_app(app: App) App {
  let middleware_handlers: &mut [Middleware] = &mut []
  for middleware in app.middleware_handlers {
    middleware_handlers.push(middleware)
  }
  let routes: &mut [Route] = &mut []
  for route in app.routes {
    routes.push(route)
  }
  App{
    middleware_handlers: middleware_handlers.*,
    routes: routes.*,
    max_body_bytes: app.max_body_bytes,
    _not_found_handler: app._not_found_handler,
    _method_not_allowed_handler: app._method_not_allowed_handler,
    _panic_observer: app._panic_observer,
    _completion_observer: app._completion_observer,
    _compression: app._compression,
    _security: app._security,
    _cross_origin: app._cross_origin,
    _redirect_trailing_slash: app._redirect_trailing_slash,
  }
}

private struct ServerState {
  server: &mut http::Server,
  listener: net::Listener,
  cancel_drain: fn(),
  lock: sync::Mutex,
  serving: Bool,
  stopping: Bool,
  stopped: Chan<Bool>,
  failure: Str?,
}

// A bound HTTP server for a snapshot of an `App`, created by `App.bind`.
// `serve` blocks until the server stops; `shutdown` and `close` stop it and
// may be called from other tasks, e.g. a signal handler.
struct Server {
  _store: Any,
}

impl Server {
  // The bound address, e.g. `127.0.0.1:8080`.
  fn address() Str {
    server_state(self).listener.Addr().String()
  }

  // The bound port; useful after binding port 0.
  fn port() Int {
    match net::SplitHostPort(self.address()) {
      ok(parts) => {
        let _host, port = parts
        strconv::Atoi(port).or(0)
      },
      err => 0,
    }
  }

  // Replace the server's timeouts, in milliseconds (0 disables one).
  // Defaults: read header 5s, read 30s, write 30s, idle 120s. Event streams
  // clear the write timeout and bound each event write instead. Panics
  // once `serve`, `shutdown`, or `close` has been called.
  fn set_timeouts(read_header_ms: Int?, read_ms: Int?, write_ms: Int?, idle_ms: Int?) {
    let state = server_state(self)
    state.lock.Lock()
    defer state.lock.Unlock()
    if state.serving or state.stopping {
      panic("server timeouts must be set before serving")
    }
    let server = state.server
    read_header_ms.map(fn(ms) {
      server.ReadHeaderTimeout = milliseconds(ms)
    })
    read_ms.map(fn(ms) {
      server.ReadTimeout = milliseconds(ms)
    })
    write_ms.map(fn(ms) {
      server.WriteTimeout = milliseconds(ms)
    })
    idle_ms.map(fn(ms) {
      server.IdleTimeout = milliseconds(ms)
    })
  }

  // Accept and serve connections until `shutdown` or `close` finishes.
  // Returns ok after a graceful stop, or the error that stopped serving.
  fn serve() Void!Str {
    let state = server_state(self)
    mark_serving(state)
    // Serve closes the listener when it returns, including when the server
    // was stopped before serving began.
    match state.server.Serve(state.listener) {
      ok => Result::ok(()),
      err(error) => {
        if errors::Is(error, http::ErrServerClosed) {
          state.stopped.recv()
          match state.failure {
            failure => Result::err(failure),
            _ => Result::ok(()),
          }
        } else {
          Result::err(error.error())
        }
      },
    }
  }

  // Stop gracefully: close the listener, end event streams (their
  // `done()` fires and `cancelled()` becomes true; `request.draining()`
  // turns true), and wait up to `timeout_ms` (default 10s) for in-flight
  // requests. Connections still open at the deadline are closed and an
  // error is returned. Later calls wait for the first one.
  fn shutdown(timeout_ms: Int?) Void!Str {
    let state = server_state(self)
    if begin_stop(state) {
      release_unserved_listener(state)
      state.cancel_drain()
      let deadline, cancel = go_context::WithTimeout(
        go_context::Background(),
        milliseconds(timeout_ms.or(DEFAULT_SHUTDOWN_TIMEOUT_MS)),
      )
      match state.server.Shutdown(deadline) {
        ok => (),
        err(error) => {
          state.server.Close()
          state.failure = Maybe::new("graceful shutdown did not finish: {error.error()}")
        },
      }
      cancel()
      state.stopped.close()
    } else {
      state.stopped.recv()
    }
    match state.failure {
      failure => Result::err(failure),
      _ => Result::ok(()),
    }
  }

  // Stop immediately, closing every connection.
  fn close() Void!Str {
    let state = server_state(self)
    let first = begin_stop(state)
    if first {
      release_unserved_listener(state)
    }
    state.cancel_drain()
    let result = state.server.Close().map_err(error_message)
    if first {
      state.stopped.close()
    }
    result
  }
}

private fn server_state(server: Server) &mut ServerState {
  unsafe::cast<&mut ServerState>(server._store).expect("invalid internal server state")
}

// Mark the server as stopping; true for the first caller only.
private fn begin_stop(state: &mut ServerState) Bool {
  state.lock.Lock()
  defer state.lock.Unlock()
  let first = not state.stopping
  state.stopping = true
  first
}

private fn mark_serving(state: &mut ServerState) {
  state.lock.Lock()
  defer state.lock.Unlock()
  state.serving = true
}

// Close the listener of a server stopped before `serve`; Go's server only
// closes listeners that `Serve` has registered.
private fn release_unserved_listener(state: &mut ServerState) {
  state.lock.Lock()
  defer state.lock.Unlock()
  if not state.serving {
    state.listener.Close()
  }
}

private fn milliseconds(ms: Int) time::Duration {
  time::Duration::from(ms) * time::Millisecond
}

struct Group {
  _app: &mut App,
  _prefix: Str,
  _middleware_handlers: [Middleware],
  _allow_cross_origin: Bool?,
}

impl Group {
  fn mut use(middleware: Middleware) {
    let middleware_handlers = &mut copy_middleware(self._middleware_handlers)
    middleware_handlers.push(middleware)
    self._middleware_handlers = middleware_handlers.*
  }

  fn mut group(prefix: Str) Group {
    validate_group_prefix(prefix)
    Group{
      _app: self._app,
      _prefix: join_group_prefix(self._prefix, prefix),
      _middleware_handlers: copy_middleware(self._middleware_handlers),
      _allow_cross_origin: self._allow_cross_origin,
    }
  }

  // Exempt routes registered on this group afterwards, and groups created
  // from it afterwards, from cross-origin request protection, e.g. for
  // endpoints that legitimately receive cross-site browser form posts.
  fn mut allow_cross_origin() {
    self._allow_cross_origin = Maybe::new(true)
  }

  fn mut route(method: Str, path: Str, handler: Handler) {
    validate_route_path(path)
    register_route(
      self._app,
      method,
      join_group_route(self._prefix, path),
      self._middleware_handlers,
      self._allow_cross_origin.or(false),
      handler,
    )
  }

  fn mut get(path: Str, handler: Handler) {
    self.route("GET", path, handler)
  }

  fn mut head(path: Str, handler: Handler) {
    self.route("HEAD", path, handler)
  }

  fn mut post(path: Str, handler: Handler) {
    self.route("POST", path, handler)
  }

  fn mut put(path: Str, handler: Handler) {
    self.route("PUT", path, handler)
  }

  fn mut patch(path: Str, handler: Handler) {
    self.route("PATCH", path, handler)
  }

  fn mut delete(path: Str, handler: Handler) {
    self.route("DELETE", path, handler)
  }

  fn mut options(path: Str, handler: Handler) {
    self.route("OPTIONS", path, handler)
  }

  fn mut trace(path: Str, handler: Handler) {
    self.route("TRACE", path, handler)
  }
}

private fn register_route(
  app: &mut App,
  method: Str,
  path: Str,
  middleware_handlers: [Middleware],
  allow_cross_origin: Bool,
  handler: Handler,
) {
  validate_route(method, path)
  let segments = compile_route(path)
  for existing in app.routes {
    if existing.method == method {
      let same_shape = route_shapes_equal(existing.segments, segments)
      let catch_all_overlap = (route_has_catch_all(existing.segments) or route_has_catch_all(segments)) and route_patterns_overlap(existing.segments, segments, 0)
      if same_shape or catch_all_overlap {
        panic("conflicting route: {method} {path}")
      }
    }
  }
  app.routes.push(
    Route{
      method: method,
      path: path,
      segments: segments,
      middleware_handlers: copy_middleware(middleware_handlers),
      handler: handler,
      allow_cross_origin: Maybe::new(allow_cross_origin),
    },
  )
}

private fn copy_middleware(middleware_handlers: [Middleware]) [Middleware] {
  let copied: &mut [Middleware] = &mut []
  for middleware in middleware_handlers {
    copied.push(middleware)
  }
  copied.*
}

private fn join_group_prefix(parent: Str, child: Str) Str {
  if parent == "/" {
    child
  } else if child == "/" {
    parent
  } else {
    "{parent}{child}"
  }
}

private fn join_group_route(prefix: Str, path: Str) Str {
  if prefix == "/" {
    path
  } else {
    "{prefix}{path}"
  }
}

private struct RequestTarget {
  path: Str,
  raw_query: Str,
}

private fn parse_request_target(target: Str) RequestTarget {
  match url::ParseRequestURI(target) {
    ok(parsed) => RequestTarget{path: parsed.Path, raw_query: parsed.RawQuery},
    err(message) => panic("invalid request target '{target}': {message}"),
  }
}

private fn parse_query_values(raw_query: Str, name: Str) [Str] {
  let parsed = &mut url::URL{}
  parsed.RawQuery = raw_query
  let values = parsed.Query()
  values.get(name).or([])
}

private fn make_next(callback: fn(Request, &mut Response)) Next {
  let state = &mut NextState{callback: callback, ran: false}
  Next{store: state}
}

// `serve_http`, then report the delivery to the completion observer. The
// report is deferred so aborted event streams are reported too.
private fn serve_observed(
  middleware_handlers: [Middleware],
  routes: [Route],
  fallback_handlers: FallbackHandlers,
  max_body_bytes: Int,
  options: ServeOptions,
  writer: http::ResponseWriter,
  raw_request: &mut http::Request,
) {
  let record = &mut DeliveryRecord{status: 0, bytes: 0}
  let started = time::Now()
  let method = raw_request.Method
  let path = raw_request.URL.Path
  defer {
    match options.complete {
      observer => {
        observer(
          Completion{
            method: method,
            path: path,
            status: record.status,
            bytes: record.bytes,
            duration: time::Since(started),
          },
        )
      },
      _ => (),
    }
  }
  serve_http(
    middleware_handlers,
    routes,
    fallback_handlers,
    max_body_bytes,
    options,
    record,
    writer,
    raw_request,
  )
}

private fn serve_http(
  middleware_handlers: [Middleware],
  routes: [Route],
  fallback_handlers: FallbackHandlers,
  max_body_bytes: Int,
  options: ServeOptions,
  record: &mut DeliveryRecord,
  writer: http::ResponseWriter,
  raw_request: &mut http::Request,
) {
  let headers = &mut Headers::new()
  for name in raw_request.Header.keys() {
    for value in raw_request.Header.Values(name) {
      headers.add(name, value)
    }
  }

  if raw_request.ContentLength > Int64::from(max_body_bytes) {
    raw_request.Body.Close()
    deliver_http_response(
      writer,
      raw_request.Method,
      raw_request.URL.Path,
      raw_request.Context(),
      finalize_response(raw_request.Method, apply_security_defaults(payload_too_large(), options)),
      options,
      record,
    )
  } else {
    let limited_body = io::LimitReader(raw_request.Body, Int64::from(max_body_bytes) + 1)
    match io::ReadAll(limited_body) {
      ok(body) => {
        if body.size() > max_body_bytes {
          raw_request.Body.Close()
          deliver_http_response(
            writer,
            raw_request.Method,
            raw_request.URL.Path,
            raw_request.Context(),
            finalize_response(
              raw_request.Method,
              apply_security_defaults(payload_too_large(), options),
            ),
            options,
            record,
          )
        } else {
          let request = Request{
            method: raw_request.Method,
            path: raw_request.URL.Path,
            raw_query: raw_request.URL.RawQuery,
            headers: headers.*,
            body: body,
            context: raw_request.Context(),
            path_params: [:],
            host: Maybe::new(raw_request.Host),
          }
          deliver_http_response(
            writer,
            raw_request.Method,
            raw_request.URL.Path,
            raw_request.Context(),
            handle_bounded(
              middleware_handlers,
              routes,
              fallback_handlers,
              max_body_bytes,
              options,
              request,
            ),
            options,
            record,
          )
        }
      },
      err(_) => {
        deliver_http_response(
          writer,
          raw_request.Method,
          raw_request.URL.Path,
          raw_request.Context(),
          finalize_response(raw_request.Method, apply_security_defaults(bad_request(), options)),
          options,
          record,
        )
      },
    }
  }
}

private fn handle_bounded(
  middleware_handlers: [Middleware],
  routes: [Route],
  fallback_handlers: FallbackHandlers,
  max_body_bytes: Int,
  options: ServeOptions,
  request: Request,
) Response {
  if request.body.size() > max_body_bytes {
    finalize_safely(request.method, apply_security_defaults(payload_too_large(), options))
  } else {
    let response = handle_safely(middleware_handlers, routes, fallback_handlers, options, request)
    match unsafe {
      finalize_response(
        request.method,
        negotiate(request, apply_security_defaults(response, options), options.compression),
      )
    } {
      ok(finalized) => finalized,
      err(_) => {
        finalize_response(request.method, apply_security_defaults(internal_server_error(), options))
      },
    }
  }
}

// Representation selection and conditional requests, after all middleware:
// choose gzip or identity, then answer 304 when `If-None-Match` holds the
// selected representation's ETag.
private fn negotiate(request: Request, response: Response, compression: Compression?) Response {
  mut response = response
  let negotiated = &mut response
  if response_state(response).mode == ResponseMode::Buffered {
    let gzip = match compression {
      settings => select_gzip(request, negotiated, settings),
      _ => false,
    }
    let etag = negotiated.headers.get("ETag").or("")
    if gzip and etag != "" {
      negotiated.headers.set("ETag", gzip_etag(etag))
    }
    if not_modified(request, negotiated.*) {
      negotiated.status = 304
      negotiated.body = []
    } else if gzip {
      let settings = compression.expect("gzip selected without compression")
      negotiated.body = settings.cache.compress(
        negotiated.headers.get("ETag").or(""),
        negotiated.body,
      )
      negotiated.headers.set("Content-Encoding", "gzip")
    }
  }
  negotiated.*
}

// Whether to gzip this response for this request. Adds `Vary:
// Accept-Encoding` to every response whose encoding depends on the client.
private fn select_gzip(request: Request, response: &mut Response, settings: Compression) Bool {
  let status = response.status
  let has_body = status >= 200 and status != 204 and status != 205 and status != 304 and status != 206
  let media = media_type(response.headers.get("Content-Type").or(""))
  let eligible = has_body and response.body.size() > 0 and response.body.size() >= settings.min_bytes and response.headers.get("Content-Encoding").is_none() and (not has_directive(response.headers.values("Cache-Control"), "no-transform")) and compressible(media, settings.types)
  if eligible {
    let varies = has_directive(response.headers.values("Vary"), "Accept-Encoding") or has_directive(response.headers.values("Vary"), "*")
    if not varies {
      response.headers.add("Vary", "Accept-Encoding")
    }
    accepts_gzip(request.headers.values("Accept-Encoding"))
  } else {
    false
  }
}

private fn not_modified(request: Request, response: Response) Bool {
  let etag = response.headers.get("ETag").or("")
  let method_applies = request.method == "GET" or request.method == "HEAD"
  if (not method_applies) or response.status != 200 or etag == "" {
    false
  } else {
    mut matched = false
    for value in request.headers.values("If-None-Match") {
      for candidate in strings::Split(value, ",") {
        let tag = strings::TrimSpace(candidate)
        if tag == "*" or weak_opaque(tag) == weak_opaque(etag) {
          matched = true
        }
      }
    }
    matched
  }
}

// An entity tag without its weakness indicator, for weak comparison.
private fn weak_opaque(tag: Str) Str {
  strings::TrimPrefix(strings::TrimSpace(tag), "W/")
}

private fn gzip_etag(etag: Str) Str {
  if strings::HasSuffix(etag, "\"") and not strings::HasSuffix(etag, "-gzip\"") {
    "{strings::TrimSuffix(etag, "\"")}-gzip\""
  } else {
    etag
  }
}

private fn media_type(content_type: Str) Str {
  let main_part = strings::Split(content_type, ";").at(0).or("")
  strings::ToLower(strings::TrimSpace(main_part))
}

// Whether a comma-separated header (e.g. Cache-Control, Vary) lists
// `name`, ignoring case, whitespace, and directive arguments.
private fn has_directive(values: [Str], name: Str) Bool {
  mut found = false
  for value in values {
    for part in strings::Split(value, ",") {
      let directive = strings::Split(part, "=").at(0).or("")
      if strings::EqualFold(strings::TrimSpace(directive), name) {
        found = true
      }
    }
  }
  found
}

private fn accepts_gzip(values: [Str]) Bool {
  mut gzip: Bool? = Maybe::new()
  mut wildcard = false
  for value in values {
    for part in strings::Split(value, ",") {
      let fields = strings::Split(part, ";")
      let name = strings::ToLower(strings::TrimSpace(fields.at(0).or("")))
      mut allowed = true
      for field in fields {
        let pair = strings::SplitN(field, "=", 2)
        if pair.size() == 2 and strings::EqualFold(strings::TrimSpace(pair.at(0).or("")), "q") {
          match strconv::ParseFloat(strings::TrimSpace(pair.at(1).or("")), 64) {
            ok(q) => {
              if q == 0.0 {
                allowed = false
              }
            },
            err => (),
          }
        }
      }
      if name == "gzip" {
        gzip = Maybe::new(allowed)
      } else if name == "*" {
        wildcard = allowed
      }
    }
  }
  gzip.or(wildcard)
}

private fn compressible(media: Str, types: [Str]?) Bool {
  match types {
    allowed => {
      mut found = false
      for entry in allowed {
        let wanted = strings::ToLower(entry)
        if wanted == media or strings::HasSuffix(wanted, "/*") and strings::HasPrefix(media, strings::TrimSuffix(wanted, "*")) {
          found = true
        }
      }
      found
    },
    _ => {
      if media == "text/event-stream" {
        false
      } else if strings::HasPrefix(media, "text/") or strings::HasSuffix(media, "+json") or strings::HasSuffix(media, "+xml") {
        true
      } else {
        list_contains(
          [
            "application/json",
            "application/javascript",
            "application/xml",
            "application/wasm",
            "image/svg+xml",
          ],
          media,
        )
      }
    },
  }
}

private fn compression_settings(stored: Any?) Compression? {
  match stored {
    value => unsafe::cast<Compression>(value),
    _ => Maybe::new(),
  }
}

private struct Compression {
  min_bytes: Int,
  types: [Str]?,
  cache: &mut GzipCache,
}

// Compressed bodies by strong ETag, so unchanged assets are compressed once.
// Bounded because applications choose the tags.
private struct GzipCache {
  lock: sync::Mutex,
  entries: [Str: [Byte]],
}

impl GzipCache {
  fn mut compress(etag: Str, body: [Byte]) [Byte] {
    let cacheable = etag != "" and not strings::HasPrefix(etag, "W/")
    self.lock.Lock()
    let cached = match cacheable {
      true => self.entries.get(etag),
      false => Maybe::new(),
    }
    self.lock.Unlock()
    match cached {
      hit => hit,
      _ => {
        let compressed = gzip_bytes(body)
        if cacheable {
          self.lock.Lock()
          if self.entries.size() < GZIP_CACHE_ENTRIES {
            self.entries.set(etag, compressed)
          }
          self.lock.Unlock()
        }
        compressed
      },
    }
  }
}

private fn gzip_bytes(body: [Byte]) [Byte] {
  let buffer = &mut bytes::Buffer{}
  let writer = gzip::NewWriter(buffer)
  mut input = body
  writer.Write(&mut input)
  writer.Close()
  buffer.Bytes()
}

private fn finalize_safely(method: Str, response: Response) Response {
  match unsafe {
    finalize_response(method, response)
  } {
    ok(finalized) => finalized,
    err(_) => finalize_response(method, internal_server_error()),
  }
}

private fn handle_safely(
  middleware_handlers: [Middleware],
  routes: [Route],
  fallback_handlers: FallbackHandlers,
  options: ServeOptions,
  request: Request,
) Response {
  let trace = &mut PanicTrace{completed: false, stack: ""}
  match unsafe {
    trace_panics(trace, fn() {
      handle_request(
        middleware_handlers,
        routes,
        fallback_handlers,
        options.cross_origin,
        options.redirect_trailing_slash,
        request,
      )
    })
  } {
    ok(response) => response,
    err(message) => {
      report_panic(
        options,
        Panic{
          method: request.method,
          path: request.path,
          message: message,
          stack: trace.stack,
        },
      )
      internal_server_error()
    },
  }
}

private struct RouteSelection {
  index: Int,
  params: [Str: Str],
  path_found: Bool,
  allowed_methods: [Str],
}

// The most specific route for `method` at `path`, with `HEAD` falling back
// to `GET`, and every method whose routes match the path.
private fn select_route(routes: [Route], method: Str, path: Str) RouteSelection {
  mut route_index = -1
  mut route_params: [Str: Str] = [:]
  mut get_route_index = -1
  mut get_route_params: [Str: Str] = [:]
  mut candidate_index = 0
  mut path_found = false
  mut allowed_methods: [Str] = []
  let path_segments = strings::Split(path, "/")

  for route in routes {
    let matched = match_route(route.segments, path_segments)
    if matched.matches {
      path_found = true
      allowed_methods = append_unique(allowed_methods, route.method)
      if route.method == "GET" and route_is_preferred(routes, get_route_index, route) {
        get_route_index = candidate_index
        get_route_params = matched.params
      }
      if route.method == method and route_is_preferred(routes, route_index, route) {
        route_index = candidate_index
        route_params = matched.params
      }
    }
    candidate_index =+ 1
  }
  if method == "HEAD" and route_index == -1 {
    route_index = get_route_index
    route_params = get_route_params
  }
  if list_contains(allowed_methods, "GET") {
    allowed_methods = append_unique(allowed_methods, "HEAD")
  }
  RouteSelection{
    index: route_index,
    params: route_params,
    path_found: path_found,
    allowed_methods: allowed_methods,
  }
}

// `path` with its trailing slash added or removed. None for the root, for
// paths with `.` or `..` segments (clients would resolve them elsewhere),
// and for any result that would not be a local path, such as `//host`.
private fn toggle_trailing_slash(path: Str) Str? {
  let toggled = match strings::HasSuffix(path, "/") {
    true => strings::TrimSuffix(path, "/"),
    false => "{path}/",
  }
  mut dot_segment = false
  for segment in strings::Split(path, "/") {
    if segment == "." or segment == ".." {
      dot_segment = true
    }
  }
  match path == "/" or dot_segment or (not strings::HasPrefix(path, "/")) {
    true => Maybe::new(),
    false => local_path(toggled),
  }
}

// The redirect for a request that matched no route, when the other
// trailing-slash form of its path has a route for its method. The query is
// kept, with `\` and `#` escaped so it survives as one local query.
private fn trailing_slash_redirect(routes: [Route], request: Request) Handler? {
  let target = match toggle_trailing_slash(request.path) {
    toggled => {
      match select_route(routes, request.method, toggled).index >= 0 {
        true => {
          let escaped = &mut url::URL{}
          escaped.Path = toggled
          let query = strings::ReplaceAll(
            strings::ReplaceAll(request.raw_query, "\\", "%5C"),
            "#",
            "%23",
          )
          let location = match query {
            "" => escaped.EscapedPath(),
            _ => "{escaped.EscapedPath()}?{query}",
          }
          local_path(location)
        },
        false => Maybe::new(),
      }
    },
    _ => Maybe::new(),
  }
  match target {
    location => {
      Maybe::new(fn(request: Request, response: &mut Response) {
        response.redirect(location, status: 308)
      })
    },
    _ => Maybe::new(),
  }
}

private fn handle_request(
  middleware_handlers: [Middleware],
  routes: [Route],
  fallback_handlers: FallbackHandlers,
  cross_origin: CrossOrigin?,
  redirect_trailing_slash: Bool,
  request: Request,
) Response {
  mut request = request
  let response = &mut Response::new()
  let selection = select_route(routes, request.method, request.path)
  let route_index = selection.index
  let route_params = selection.params

  mut selected_handler: Handler? = Maybe::new()
  let selected_middleware = &mut copy_middleware(middleware_handlers)
  if route_index >= 0 {
    let matched_route = routes.at(route_index).expect("matched route index is in bounds")
    selected_handler = Maybe::new(matched_route.handler)
    for middleware in matched_route.middleware_handlers {
      selected_middleware.push(middleware)
    }
  } else if selection.path_found {
    mut allowed_methods = selection.allowed_methods
    response.status = 405
    response.headers.set("Allow", strings::Join(&mut allowed_methods, ", "))
    selected_handler = fallback_handlers.method_not_allowed
  } else {
    let redirect = match redirect_trailing_slash {
      true => trailing_slash_redirect(routes, request),
      false => Maybe::new(),
    }
    selected_handler = match redirect {
      handler => Maybe::new(handler),
      _ => fallback_handlers.not_found,
    }
  }

  mut exempt = false
  if route_index >= 0 {
    exempt = routes.at(
      route_index,
    ).expect("matched route index is in bounds").allow_cross_origin.or(false)
  }
  let rejected = match cross_origin {
    settings => (not exempt) and cross_origin_rejected(request, settings),
    _ => false,
  }
  if rejected {
    forbidden_cross_origin()
  } else {
    let routed_request = &mut request
    routed_request.path_params = route_params
    dispatch(selected_middleware.*, 0, selected_handler, routed_request.*, response)
    response.*
  }
}

private fn dispatch(
  middleware_handlers: [Middleware],
  index: Int,
  handler: Handler?,
  request: Request,
  response: &mut Response,
) {
  response_state(response.*).context = Maybe::new(request.context)
  if index < middleware_handlers.size() {
    let middleware = middleware_handlers.at(index).expect("middleware index is in bounds")
    let next = make_next(fn(next_request: Request, next_response: &mut Response) {
      dispatch(middleware_handlers, index + 1, handler, next_request, next_response)
    })
    middleware(request, response, next)
  } else {
    match handler {
      selected => selected(request, response),
      _ => (),
    }
  }
}

private struct RouteMatch {
  matches: Bool,
  params: [Str: Str],
}

private fn compile_route(path: Str) [RouteSegment] {
  let segments: &mut [RouteSegment] = &mut []
  let parameter_names: &mut [Str: Bool] = &mut [:]
  let path_segments = strings::Split(path, "/")
  for segment, index in path_segments {
    let parameter = strings::HasPrefix(segment, ":")
    let catch_all = strings::HasPrefix(segment, "*")
    if parameter or catch_all {
      let name = match catch_all {
        true => strings::TrimPrefix(segment, "*"),
        false => strings::TrimPrefix(segment, ":"),
      }
      if not valid_path_param_name(name) {
        panic("invalid path parameter: {segment}")
      }
      if catch_all and index != path_segments.size() - 1 {
        panic("catch-all path parameter must be the final segment: {segment}")
      }
      if parameter_names.get(name).is_some() {
        panic("duplicate path parameter: {name}")
      }
      parameter_names.set(name, true)
      segments.push(RouteSegment{value: segment, name: Maybe::new(name)})
    } else {
      segments.push(RouteSegment{value: segment, name: Maybe::new()})
    }
  }
  segments.*
}

private fn route_segment_is_catch_all(segment: RouteSegment) Bool {
  segment.name.is_some() and strings::HasPrefix(segment.value, "*")
}

private fn route_has_catch_all(segments: [RouteSegment]) Bool {
  match segments.at(segments.size() - 1) {
    segment => route_segment_is_catch_all(segment),
    _ => false,
  }
}

private fn route_patterns_overlap(left: [RouteSegment], right: [RouteSegment], index: Int) Bool {
  match (left.at(index), right.at(index)) {
    (some(left_segment), some(right_segment)) => {
      if route_segment_is_catch_all(left_segment) or route_segment_is_catch_all(right_segment) {
        true
      } else if route_segments_overlap(left_segment, right_segment) {
        route_patterns_overlap(left, right, index + 1)
      } else {
        false
      }
    },
    (none, none) => true,
    _ => false,
  }
}

private fn route_segments_overlap(left: RouteSegment, right: RouteSegment) Bool {
  match (left.name.is_some(), right.name.is_some()) {
    (true, true) => true,
    (true, false) => right.value != "",
    (false, true) => left.value != "",
    (false, false) => left.value == right.value,
  }
}

private enum RouteSegmentKind {
  Static,
  Parameter,
  CatchAll,
}

private fn route_segment_kind(segment: RouteSegment) RouteSegmentKind {
  if route_segment_is_catch_all(segment) {
    RouteSegmentKind::CatchAll
  } else if segment.name.is_some() {
    RouteSegmentKind::Parameter
  } else {
    RouteSegmentKind::Static
  }
}

private fn route_shapes_equal(left: [RouteSegment], right: [RouteSegment]) Bool {
  if left.size() != right.size() {
    false
  } else {
    mut equal = true
    for left_segment, index in left {
      let right_segment = right.at(index).expect("route segment index is in bounds")
      let left_kind = route_segment_kind(left_segment)
      let right_kind = route_segment_kind(right_segment)
      if left_kind != right_kind {
        equal = false
      } else if left_kind == RouteSegmentKind::Static and left_segment.value != right_segment.value {
        equal = false
      }
    }
    equal
  }
}

private fn match_route(route_segments: [RouteSegment], path_segments: [Str]) RouteMatch {
  let catch_all = route_has_catch_all(route_segments)
  mut matches = match catch_all {
    true => path_segments.size() >= route_segments.size(),
    false => route_segments.size() == path_segments.size(),
  }
  let params: &mut [Str: Str] = &mut [:]
  if matches {
    for route_segment, index in route_segments {
      if route_segment_is_catch_all(route_segment) {
        if matches {
          let remaining: &mut [Str] = &mut []
          for path_segment, path_index in path_segments {
            if path_index >= index {
              remaining.push(path_segment)
            }
          }
          params.set(route_segment.name.or(""), "/{strings::Join(remaining, "/")}")
        }
      } else {
        let path_segment = path_segments.at(index).expect("path segment index is in bounds")
        if route_segment.name.is_some() {
          if path_segment == "" {
            matches = false
          } else {
            params.set(route_segment.name.or(""), path_segment)
          }
        } else if route_segment.value != path_segment {
          matches = false
        }
      }
    }
  }
  RouteMatch{matches: matches, params: params.*}
}

private fn route_is_preferred(routes: [Route], current_index: Int, candidate: Route) Bool {
  if current_index < 0 {
    true
  } else {
    let current = routes.at(current_index).expect("selected route index is in bounds")
    route_more_specific(candidate.segments, current.segments)
  }
}

private fn route_more_specific(candidate: [RouteSegment], current: [RouteSegment]) Bool {
  mut decided = false
  mut preferred = false
  for candidate_segment, index in candidate {
    let current_segment = current.at(index).expect("route segment index is in bounds")
    let candidate_is_param = candidate_segment.name.is_some()
    let current_is_param = current_segment.name.is_some()
    if (not decided) and candidate_is_param != current_is_param {
      decided = true
      preferred = not candidate_is_param
    }
  }
  preferred
}

private fn valid_path_param_name(name: Str) Bool {
  if name == "" {
    false
  } else {
    mut valid = true
    for character in name.runes() {
      let letter = character >= 'a' and character <= 'z' or character >= 'A' and character <= 'Z'
      let digit = character >= '0' and character <= '9'
      if (not letter) and (not digit) and character != '_' {
        valid = false
      }
    }
    valid
  }
}

private fn finalize_response(method: Str, response: Response) Response {
  mut response = response
  let state = response_state(response)
  if state.mode == ResponseMode::SSE and (response.status != 200 or response.body.size() > 0) {
    mut replacement = response
    select_buffered(&mut replacement)
    finalize_response(method, replacement)
  } else {
    let mode = state.mode
    let body_allowed = response.status != 204 and response.status != 205 and response.status != 304
    if response.status < 200 or response.status > 599 {
      finalize_response(method, internal_server_error())
    } else if method == "CONNECT" and response.status >= 200 and response.status < 300 {
      finalize_response(method, internal_server_error())
    } else {
      let finalized = &mut response
      finalized.headers.delete("Transfer-Encoding")
      finalized.headers.delete("Trailer")
      finalized.headers.delete("Content-Length")
      if mode == ResponseMode::Buffered and body_allowed {
        finalized.headers.set("Content-Length", response.body.size().to_str())
      }
      if mode == ResponseMode::SSE {
        finalized.headers.set("Content-Type", "text/event-stream")
        finalized.headers.set("Cache-Control", "no-cache")
        finalized.headers.set("X-Content-Type-Options", "nosniff")
      }
      if method == "HEAD" or not body_allowed or mode == ResponseMode::SSE {
        finalized.body = []
      }
      finalized.*
    }
  }
}

private fn internal_server_error() Response {
  let response = &mut Response::new()
  response.text(500, "Internal Server Error")
  response.*
}

private fn payload_too_large() Response {
  let response = &mut Response::new()
  response.text(413, "Payload Too Large")
  response.*
}

private fn bad_request() Response {
  let response = &mut Response::new()
  response.text(400, "Bad Request")
  response.*
}

private fn validate_route(method: Str, path: Str) {
  if not valid_token(method) {
    panic("invalid HTTP method: {method}")
  }
  validate_route_path(path)
}

private fn validate_route_path(path: Str) {
  if (not strings::HasPrefix(path, "/")) or strings::Contains(path, "?") or strings::Contains(path, "#") {
    panic("route path must start with '/' and contain no query or fragment: {path}")
  }
}

private fn validate_group_prefix(prefix: Str) {
  validate_route_path(prefix)
  if prefix != "/" and strings::HasSuffix(prefix, "/") {
    panic("group prefix cannot end with '/': {prefix}")
  }
  for segment in strings::Split(prefix, "/") {
    if strings::HasPrefix(segment, ":") or strings::HasPrefix(segment, "*") {
      panic("group prefixes cannot contain parameters: {prefix}")
    }
  }
}

private fn validate_header(name: Str, value: Str) {
  if not valid_token(name) {
    panic("invalid HTTP header name: {name}")
  }
  for character in value.runes() {
    if character != '\t' and (character < ' ' or character == '\x7f') {
      panic("HTTP header values cannot contain control characters other than HTAB")
    }
  }
}

private fn valid_token(value: Str) Bool {
  if value == "" {
    false
  } else {
    mut valid = true
    for character in value.runes() {
      let letter = character >= 'a' and character <= 'z' or character >= 'A' and character <= 'Z'
      let digit = character >= '0' and character <= '9'
      let symbol = strings::Contains("!#$%&'*+-.^_`|~", character.to_str())
      if (not letter) and (not digit) and (not symbol) {
        valid = false
      }
    }
    valid
  }
}

private fn list_contains(values: [Str], expected: Str) Bool {
  mut found = false
  for value in values {
    if value == expected {
      found = true
    }
  }
  found
}

private fn append_unique(values: [Str], value: Str) [Str] {
  mut values = values
  let result = &mut values
  if not list_contains(values, value) {
    result.push(value)
  }
  result.*
}

private fn deliver_http_response(
  writer: http::ResponseWriter,
  method: Str,
  path: Str,
  request_context_value: go_context::Context,
  response: Response,
  options: ServeOptions,
  record: &mut DeliveryRecord,
) {
  let state = response_state(response)
  if state.mode == ResponseMode::SSE and method != "HEAD" {
    deliver_sse_response(
      writer,
      request_context_value,
      state.context.or(request_context_value),
      response,
      state.sse_handler.expect("missing SSE handler"),
      Panic{
        method: method,
        path: path,
        message: "",
        stack: "",
      },
      options,
      record,
    )
  } else {
    write_http_response(writer, response, record)
  }
}

private fn deliver_sse_response(
  writer: http::ResponseWriter,
  transport_context: go_context::Context,
  request_context_value: go_context::Context,
  response: Response,
  handler: SSEHandler,
  origin: Panic,
  options: ServeOptions,
  record: &mut DeliveryRecord,
) {
  // The stream ends when the request or transport is cancelled, or when the
  // serving `Server` starts draining.
  let stream_context, cancel_stream = go_context::WithCancel(request_context_value)
  defer cancel_stream()
  let stop_transport = go_context::AfterFunc(transport_context, fn() {
    cancel_stream()
  })
  defer stop_transport()
  let stop_drain: fn() Bool = match drain_signal(transport_context) {
    drain => {
      go_context::AfterFunc(drain.context, fn() {
        cancel_stream()
      })
    },
    _ => {
      fn() Bool {
        false
      }
    },
  }
  defer stop_drain()

  let state = &mut EventStreamState{
    writer: writer,
    context: stream_context,
    transport_context: transport_context,
    status: response.status,
    headers: response.headers.clone(),
    committed: false,
    usable: true,
    record: record,
  }
  let stream = &mut EventStream{store: state}
  let controller = http::NewResponseController(writer)
  match controller.SetWriteDeadline(time::Time{}) {
    ok => (),
    err(_) => (),
  }
  let trace = &mut PanicTrace{completed: false, stack: ""}
  match unsafe {
    trace_panics(trace, fn() {
      handler(stream)
      commit_event_stream(stream)
    })
  } {
    ok(_) => { state.usable = false },
    err(message) => {
      state.usable = false
      report_panic(
        options,
        Panic{
          method: origin.method,
          path: origin.path,
          message: message,
          stack: trace.stack,
        },
      )
      if state.committed {
        panic(http::ErrAbortHandler)
      } else {
        write_http_response(
          writer,
          finalize_response("GET", apply_security_defaults(internal_server_error(), options)),
          record,
        )
      }
    },
  }
}

private fn copy_http_headers(writer: http::ResponseWriter, headers: Headers) {
  for name in headers.names() {
    for value in headers.values(name) {
      writer.Header().Add(name, value)
    }
  }
}

private fn write_http_response(
  writer: http::ResponseWriter,
  response: Response,
  record: &mut DeliveryRecord,
) {
  copy_http_headers(writer, response.headers)
  writer.WriteHeader(response.status)
  record.status = response.status
  mut body = response.body
  match writer.Write(&mut body) {
    ok(count) => { record.bytes = count },
    err(_) => (),
  }
}
